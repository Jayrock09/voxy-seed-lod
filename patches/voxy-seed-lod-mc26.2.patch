+package me.cortex.voxy.client.seedlod;
+
+import it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap;
+import me.cortex.voxy.client.config.VoxyConfig;
+import me.cortex.voxy.common.Logger;
+import me.cortex.voxy.common.voxelization.VoxelizedSection;
+import me.cortex.voxy.common.voxelization.WorldVoxilizedSectionMipper;
+import me.cortex.voxy.common.world.WorldEngine;
+import me.cortex.voxy.common.world.WorldSection;
+import me.cortex.voxy.common.world.WorldUpdater;
+import me.cortex.voxy.common.world.other.Mapper;
+import me.cortex.voxy.commonImpl.WorldIdentifier;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.Holder;
+import net.minecraft.core.QuartPos;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.tags.BiomeTags;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.NoiseColumn;
+import net.minecraft.world.level.biome.Biome;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.ChunkGenerator;
+import net.minecraft.world.level.levelgen.Heightmap;
+import net.minecraft.world.level.levelgen.NoiseBasedChunkGenerator;
+import net.minecraft.world.level.levelgen.RandomState;
+
+import java.util.Arrays;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.PriorityBlockingQueue;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Produces an approximate terrain-and-vegetation Voxy cache directly from the integrated
+ * server's seed-backed chunk generator. It never asks Minecraft to create or
+ * load a chunk. Existing Voxy voxels are treated as authoritative, so ordinary
+ * chunk ingest replaces (and is never replaced by) these predictions.
+ */
+public final class SeedLodManager {
+    private static final int MAX_PENDING_TASKS = 256;
+    private static final int MAX_ENQUEUE_PER_TICK = 96;
+    private static final int RECENTER_DISTANCE = 4;
+    private static final int TELEPORT_CANCEL_DISTANCE = 32;
+    private static final int WAVE_TILE_CHUNKS = 4;
+    private static final int WAVE_PRIORITY = 0;
+    // Voxy currently leaves the low 27 bits unused. Marking predictions lets a
+    // later seed pass replace them without ever replacing authoritative chunks.
+    private static final long PREDICTION_MARKER = 1L;
+
+    private final ThreadPoolExecutor executor;
+    private final AtomicInteger pendingTasks = new AtomicInteger();
+    private final AtomicLong taskSequence = new AtomicLong();
+    // Smallest planned stride per wave tile. Moving toward an existing prediction
+    // upgrades it, while moving away never wastes work downgrading it.
+    private final ConcurrentHashMap<Long, TilePlan> plannedTiles = new ConcurrentHashMap<>();
+    private final ConcurrentHashMap<Long, Integer> completedTiles = new ConcurrentHashMap<>();
+
+    private volatile Binding binding;
+    private volatile int playerChunkX;
+    private volatile int playerChunkZ;
+    private volatile long scanGeneration;
+
+    private int scanCenterX;
+    private int scanCenterZ;
+    private int waveRing;
+    private boolean scanInitialized;
+    private boolean waveScanFinished;
+    private int scannedTargetRadius = -1;
+    private int scannedMaximumStride = -1;
+    private boolean scannedAdaptiveQuality;
+    private boolean stopped;
+
+    public SeedLodManager() {
+        int threads = Math.max(1, VoxyConfig.CONFIG.seedLodThreads);
+        AtomicInteger threadNumber = new AtomicInteger();
+        ThreadFactory factory = runnable -> {
+            Thread thread = new Thread(runnable, "Voxy seed LOD " + threadNumber.incrementAndGet());
+            thread.setDaemon(true);
+            thread.setPriority(Thread.MIN_PRIORITY);
+            return thread;
+        };
+        this.executor = new ThreadPoolExecutor(threads, threads, 30L, TimeUnit.SECONDS,
+                new PriorityBlockingQueue<>(), factory);
+        this.executor.prestartAllCoreThreads();
+    }
+
+    public void tick(Minecraft client) {
+        if (this.stopped || !VoxyConfig.CONFIG.seedLodEnabled || client.level == null || client.player == null) {
+            return;
+        }
+
+        // A remote server does not send its world seed or generator state to the client.
+        var integratedServer = client.getSingleplayerServer();
+        if (integratedServer == null || client.level.dimension() != Level.OVERWORLD) {
+            return;
+        }
+
+        ServerLevel serverLevel = integratedServer.getLevel(client.level.dimension());
+        WorldIdentifier identifier = WorldIdentifier.of(client.level);
+        if (serverLevel == null || identifier == null) {
+            return;
+        }
+
+        WorldEngine world = identifier.getOrCreateEngine();
+        if (world == null) {
+            return;
+        }
+
+        Binding current = this.binding;
+        if (current == null || current.level != serverLevel || current.world != world) {
+            var chunkSource = serverLevel.getChunkSource();
+            current = new Binding(serverLevel, world, chunkSource.getGenerator(), chunkSource.randomState(),
+                    serverLevel.getSeed());
+            this.binding = current;
+            this.plannedTiles.clear();
+            this.completedTiles.clear();
+            this.scanInitialized = false;
+            this.waveScanFinished = false;
+            this.scannedTargetRadius = -1;
+            this.scannedMaximumStride = -1;
+            this.scanGeneration++;
+        }
+
+        this.updateWorkerCount();
+
+        var playerChunk = client.player.chunkPosition();
+        this.playerChunkX = playerChunk.x();
+        this.playerChunkZ = playerChunk.z();
+
+        int centerShift = Math.max(Math.abs(this.playerChunkX - this.scanCenterX),
+                Math.abs(this.playerChunkZ - this.scanCenterZ));
+        if (!this.scanInitialized || centerShift >= RECENTER_DISTANCE) {
+            if (this.scanInitialized && centerShift >= TELEPORT_CANCEL_DISTANCE) {
+                // A teleport makes the old queue actively harmful. Ordinary
+                // movement keeps nearby work alive so the wave cannot starve.
+                this.scanGeneration++;
+            }
+            this.scanCenterX = this.playerChunkX;
+            this.scanCenterZ = this.playerChunkZ;
+            this.waveRing = 0;
+            this.scanInitialized = true;
+            this.waveScanFinished = false;
+        }
+
+        int targetRadius = Math.max(32, VoxyConfig.CONFIG.seedLodRenderDistance);
+        int maximumStride = sanitizeStride(VoxyConfig.CONFIG.seedLodSampleStride);
+        boolean adaptiveQuality = VoxyConfig.CONFIG.seedLodAdaptiveQuality;
+        if (this.scannedTargetRadius != targetRadius
+                || this.scannedMaximumStride != maximumStride
+                || this.scannedAdaptiveQuality != adaptiveQuality) {
+            this.waveRing = 0;
+            this.waveScanFinished = false;
+            this.scannedTargetRadius = targetRadius;
+            this.scannedMaximumStride = maximumStride;
+            this.scannedAdaptiveQuality = adaptiveQuality;
+            this.scanGeneration++;
+        }
+        if (this.waveScanFinished) {
+            return;
+        }
+
+        int centerTileX = Math.floorDiv(this.scanCenterX, WAVE_TILE_CHUNKS);
+        int centerTileZ = Math.floorDiv(this.scanCenterZ, WAVE_TILE_CHUNKS);
+        int tileRadius = Math.floorDiv(targetRadius + WAVE_TILE_CHUNKS - 1, WAVE_TILE_CHUNKS) + 1;
+        long targetSquared = (long) targetRadius * targetRadius;
+        int enqueued = 0;
+        while (this.waveRing <= tileRadius) {
+            long firstIndex = this.waveRing == 0 ? 0L
+                    : (long) (this.waveRing * 2 - 1) * (this.waveRing * 2 - 1);
+            long endIndex = (long) (this.waveRing * 2 + 1) * (this.waveRing * 2 + 1);
+            boolean ringComplete = true;
+
+            for (long index = firstIndex; index < endIndex; index++) {
+                Offset offset = squareSpiral(index);
+                int tileX = centerTileX + offset.x;
+                int tileZ = centerTileZ + offset.z;
+                long distanceSquared = minimumDistanceSquaredToRegion(
+                        this.scanCenterX, this.scanCenterZ, tileX, tileZ, WAVE_TILE_CHUNKS);
+                if (distanceSquared > targetSquared) {
+                    continue;
+                }
+
+                long key = net.minecraft.world.level.ChunkPos.pack(tileX, tileZ);
+                int stride = strideForDistance(
+                        (int) Math.min(Integer.MAX_VALUE, distanceSquared), 0, targetRadius);
+                Integer completedStride = this.completedTiles.get(key);
+                if (completedStride != null && completedStride <= stride) {
+                    continue;
+                }
+
+                ringComplete = false;
+                TilePlan previousPlan = this.plannedTiles.get(key);
+                if (previousPlan != null && previousPlan.stride <= stride) {
+                    continue;
+                }
+                if (this.pendingTasks.get() >= MAX_PENDING_TASKS
+                        || enqueued >= MAX_ENQUEUE_PER_TICK) {
+                    return;
+                }
+
+                TilePlan plan = new TilePlan(stride, this.scanGeneration);
+                this.plannedTiles.put(key, plan);
+                this.submitWaveTile(current, key, plan, tileX, tileZ, Math.sqrt(distanceSquared));
+                enqueued++;
+            }
+
+            if (!ringComplete) {
+                return;
+            }
+            this.waveRing++;
+        }
+        this.waveScanFinished = true;
+    }
+
+    private void submitWaveTile(Binding taskBinding, long key, TilePlan plan,
+                                int tileX, int tileZ, double distanceChunks) {
+        this.pendingTasks.incrementAndGet();
+        try {
+            this.executor.execute(new PrioritizedTask(WAVE_PRIORITY, distanceChunks,
+                    this.taskSequence.getAndIncrement(), () -> {
+                boolean keepPlanned = true;
+                boolean acquired = false;
+                try {
+                    if (this.binding != taskBinding || this.scanGeneration != plan.generation
+                            || !VoxyConfig.CONFIG.seedLodEnabled || !taskBinding.world.isLive()) {
+                        keepPlanned = false;
+                        return;
+                    }
+                    if (this.plannedTiles.get(key) != plan) {
+                        keepPlanned = false;
+                        return;
+                    }
+                    taskBinding.world.acquireRef();
+                    acquired = true;
+                    keepPlanned = generateWaveTile(
+                            taskBinding, key, plan, tileX, tileZ);
+                } catch (Throwable throwable) {
+                    keepPlanned = false;
+                    Logger.error("Seed LOD wave generation failed for tile "
+                            + tileX + ", " + tileZ, throwable);
+                } finally {
+                    if (acquired && taskBinding.world.isLive()) {
+                        taskBinding.world.releaseRef();
+                    }
+                    if (keepPlanned) {
+                        this.completedTiles.merge(key, plan.stride, Math::min);
+                    }
+                    this.plannedTiles.remove(key, plan);
+                    this.pendingTasks.decrementAndGet();
+                }
+            }));
+        } catch (RejectedExecutionException ignored) {
+            this.pendingTasks.decrementAndGet();
+            this.plannedTiles.remove(key, plan);
+        }
+    }
+
+    private void updateWorkerCount() {
+        int desired = Math.max(1, Math.min(Runtime.getRuntime().availableProcessors(),
+                VoxyConfig.CONFIG.seedLodThreads));
+        if (desired > this.executor.getMaximumPoolSize()) {
+            this.executor.setMaximumPoolSize(desired);
+            this.executor.setCorePoolSize(desired);
+        } else if (desired < this.executor.getCorePoolSize()) {
+            this.executor.setCorePoolSize(desired);
+            this.executor.setMaximumPoolSize(desired);
+        }
+    }
+
+    private static long minimumDistanceSquaredToRegion(int centerX, int centerZ,
+                                                       int regionX, int regionZ, int sizeChunks) {
+        int minX = regionX * sizeChunks;
+        int maxX = minX + sizeChunks - 1;
+        int minZ = regionZ * sizeChunks;
+        int maxZ = minZ + sizeChunks - 1;
+        long dx = centerX < minX ? (long) minX - centerX : centerX > maxX ? (long) centerX - maxX : 0L;
+        long dz = centerZ < minZ ? (long) minZ - centerZ : centerZ > maxZ ? (long) centerZ - maxZ : 0L;
+        return dx * dx + dz * dz;
+    }
+
+    private boolean generateWaveTile(Binding binding, long tileKey, TilePlan plan,
+                                     int tileX, int tileZ) {
+        int stride = plan.stride;
+        int originChunkX = tileX * WAVE_TILE_CHUNKS;
+        int originChunkZ = tileZ * WAVE_TILE_CHUNKS;
+        int originBlockX = originChunkX << 4;
+        int originBlockZ = originChunkZ << 4;
+        int tileBlocks = WAVE_TILE_CHUNKS << 4;
+        int minY = binding.level.getMinY();
+        int maxY = binding.level.getMaxY();
+        int maximumBlockX = originBlockX + tileBlocks - 1;
+        int maximumBlockZ = originBlockZ + tileBlocks - 1;
+        int minimumCellX = minimumRequiredSampleCell(originBlockX, stride);
+        int maximumCellX = maximumRequiredSampleCell(originBlockX, maximumBlockX, stride);
+        int minimumCellZ = minimumRequiredSampleCell(originBlockZ, stride);
+        int maximumCellZ = maximumRequiredSampleCell(originBlockZ, maximumBlockZ, stride);
+        int sampleWidth = maximumCellX - minimumCellX + 1;
+        int sampleHeight = maximumCellZ - minimumCellZ + 1;
+        Sample[] samples = new Sample[sampleWidth * sampleHeight];
+
+        // The lattice is aligned to world coordinates instead of each tile.
+        // This keeps strides larger than the 64-block tile continuous across
+        // tile borders while still sharing all queries inside the tile.
+        for (int cellZ = minimumCellZ; cellZ <= maximumCellZ; cellZ++) {
+            if (!isCurrentWaveTask(binding, tileKey, plan)) {
+                return false;
+            }
+            int sampleZ = cellZ - minimumCellZ;
+            for (int cellX = minimumCellX; cellX <= maximumCellX; cellX++) {
+                int sampleX = cellX - minimumCellX;
+                samples[sampleZ * sampleWidth + sampleX] = sample(binding,
+                        cellX * stride + stride / 2,
+                        cellZ * stride + stride / 2, minY, maxY);
+            }
+        }
+        SampleGrid sampleGrid = new SampleGrid(samples, sampleWidth, sampleHeight,
+                minimumCellX, minimumCellZ, stride);
+
+        int centerX = this.playerChunkX;
+        int centerZ = this.playerChunkZ;
+        List<ChunkCoordinate> chunks = new ArrayList<>(WAVE_TILE_CHUNKS * WAVE_TILE_CHUNKS);
+        for (int localZ = 0; localZ < WAVE_TILE_CHUNKS; localZ++) {
+            for (int localX = 0; localX < WAVE_TILE_CHUNKS; localX++) {
+                chunks.add(new ChunkCoordinate(originChunkX + localX, originChunkZ + localZ));
+            }
+        }
+        chunks.sort((left, right) -> Long.compare(
+                distanceSquared(left.chunkX, left.chunkZ, centerX, centerZ),
+                distanceSquared(right.chunkX, right.chunkZ, centerX, centerZ)));
+
+        for (ChunkCoordinate chunk : chunks) {
+            if (!isCurrentWaveTask(binding, tileKey, plan)) {
+                return false;
+            }
+            Int2ObjectOpenHashMap<VoxelizedSection> sections = buildChunkSectionsFromGrid(
+                    binding, chunk.chunkX, chunk.chunkZ, sampleGrid);
+            if (sections.isEmpty()
+                    || hasExistingData(binding.world, chunk.chunkX, chunk.chunkZ, sections.keySet())) {
+                continue;
+            }
+            for (VoxelizedSection section : sections.values()) {
+                WorldUpdater.insertUpdate(binding.world, section);
+            }
+        }
+        return true;
+    }
+
+    private boolean isCurrentWaveTask(Binding binding, long tileKey, TilePlan plan) {
+        return this.binding == binding && this.scanGeneration == plan.generation
+                && binding.world.isLive() && VoxyConfig.CONFIG.seedLodEnabled
+                && this.plannedTiles.get(tileKey) == plan;
+    }
+
+    private static long distanceSquared(int x, int z, int centerX, int centerZ) {
+        long dx = (long) x - centerX;
+        long dz = (long) z - centerZ;
+        return dx * dx + dz * dz;
+    }
+
+    private static int minimumRequiredSampleCell(int minimumBlock, int stride) {
+        int halfStride = stride / 2;
+        int leftCell = Math.floorDiv(minimumBlock - halfStride, stride);
+        int nearestCell = nearestSampleCell(minimumBlock, stride);
+        return Math.min(leftCell, nearestCell - 1);
+    }
+
+    private static int maximumRequiredSampleCell(int minimumBlock, int maximumBlock, int stride) {
+        int halfStride = stride / 2;
+        int leftCell = Math.floorDiv(maximumBlock - halfStride, stride);
+        int nearestCell = nearestSampleCell(maximumBlock, stride);
+        return Math.max(leftCell + 1, nearestCell + 1);
+    }
+
+    private static int nearestSampleCell(int block, int stride) {
+        int shifted = block - stride / 2;
+        int leftCell = Math.floorDiv(shifted, stride);
+        int fraction = Math.floorMod(shifted, stride);
+        return leftCell + (fraction * 2 >= stride ? 1 : 0);
+    }
+
+    private static Int2ObjectOpenHashMap<VoxelizedSection> buildChunkSectionsFromGrid(
+            Binding binding, int chunkX, int chunkZ, SampleGrid sampleGrid) {
+        int stride = sampleGrid.stride;
+        int minY = binding.level.getMinY();
+        int maxY = binding.level.getMaxY();
+        Mapper mapper = binding.world.getMapper();
+        var sections = new Int2ObjectOpenHashMap<VoxelizedSection>();
+        Sample[] columns = new Sample[16 * 16];
+
+        for (int localZ = 0; localZ < 16; localZ++) {
+            for (int localX = 0; localX < 16; localX++) {
+                int blockX = (chunkX << 4) + localX;
+                int blockZ = (chunkZ << 4) + localZ;
+                Sample terrain = terrainSample(sampleGrid, blockX, blockZ,
+                        VoxyConfig.CONFIG.seedLodSmoothing);
+                columns[(localZ << 4) | localX] = terrain;
+                if (terrain.surfaceY < minY) {
+                    continue;
+                }
+
+                int sampleX = nearestSampleCell(blockX, stride) - sampleGrid.minimumCellX;
+                int sampleZ = nearestSampleCell(blockZ, stride) - sampleGrid.minimumCellZ;
+                int bottomY = Math.max(minY, Math.min(terrain.floorY - stride + 1,
+                        lowestNeighborFloor(sampleGrid.samples, sampleGrid.width,
+                                sampleX, sampleZ, terrain.floorY)));
+                if (terrain.isOcean()) {
+                    long stoneId = prediction(mapper.getBaseId((byte) 15,
+                            Blocks.STONE.defaultBlockState(), terrain.biome));
+                    putColumn(sections, chunkX, chunkZ, localX, localZ,
+                            bottomY, terrain.floorY - 1, stoneId);
+
+                    long floorId = prediction(mapper.getBaseId((byte) 15,
+                            terrain.floorBlock, terrain.biome));
+                    putColumn(sections, chunkX, chunkZ, localX, localZ,
+                            terrain.floorY, terrain.floorY, floorId);
+
+                    long waterId = prediction(mapper.getBaseId((byte) 15,
+                            Blocks.WATER.defaultBlockState(), terrain.biome));
+                    putColumn(sections, chunkX, chunkZ, localX, localZ,
+                            terrain.floorY + 1, terrain.surfaceY, waterId);
+                } else {
+                    long stoneId = prediction(mapper.getBaseId((byte) 15,
+                            Blocks.STONE.defaultBlockState(), terrain.biome));
+                    putColumn(sections, chunkX, chunkZ, localX, localZ,
+                            bottomY, terrain.surfaceY - 1, stoneId);
+
+                    long surfaceId = prediction(mapper.getBaseId((byte) 15,
+                            terrain.surfaceBlock, terrain.biome));
+                    putColumn(sections, chunkX, chunkZ, localX, localZ,
+                            terrain.surfaceY, terrain.surfaceY, surfaceId);
+                }
+            }
+        }
+
+        if (VoxyConfig.CONFIG.seedLodVegetation && stride <= 16) {
+            addVegetation(binding, mapper, sections, chunkX, chunkZ, columns, maxY);
+        }
+        for (VoxelizedSection section : sections.values()) {
+            WorldVoxilizedSectionMipper.mipSection(section, mapper);
+        }
+        return sections;
+    }
+
+    private static Sample sample(Binding binding, int blockX, int blockZ, int minY, int maxY) {
+        if (binding.fastHeightSampling && VoxyConfig.CONFIG.seedLodFastDatapackSampling) {
+            int surfaceY = binding.generator.getBaseHeight(blockX, blockZ,
+                    Heightmap.Types.WORLD_SURFACE_WG, binding.level, binding.randomState) - 1;
+            // Above sea level the world-surface hit is necessarily solid, so a
+            // second density-column walk would return the same value. Low terrain
+            // still asks for the ocean floor to distinguish water from land.
+            int floorY = surfaceY >= binding.generator.getSeaLevel() ? surfaceY
+                    : binding.generator.getBaseHeight(blockX, blockZ,
+                    Heightmap.Types.OCEAN_FLOOR_WG, binding.level, binding.randomState) - 1;
+            int biomeY = Math.max(minY, floorY);
+            Holder<Biome> biome = binding.generator.getBiomeSource().getNoiseBiome(
+                    QuartPos.fromBlock(blockX), QuartPos.fromBlock(biomeY), QuartPos.fromBlock(blockZ),
+                    binding.randomState.sampler());
+            boolean ocean = surfaceY > floorY;
+            SurfaceKey key = new SurfaceKey(biomeId(biome), Math.floorDiv(floorY, 32), ocean);
+            SurfaceMaterial material = binding.surfaceMaterials.computeIfAbsent(key,
+                    ignored -> inferSurfaceMaterial(biome, floorY, ocean));
+            return new Sample(surfaceY, floorY, biome, material.surface, material.floor);
+        }
+
+        NoiseColumn column = binding.generator.getBaseColumn(blockX, blockZ, binding.level, binding.randomState);
+        int surfaceY = minY - 1;
+        int floorY = minY - 1;
+
+        for (int y = maxY - 1; y >= minY; y--) {
+            BlockState state = column.getBlock(y);
+            if (!state.isAir()) {
+                surfaceY = y;
+                break;
+            }
+        }
+
+        for (int y = surfaceY; y >= minY; y--) {
+            BlockState state = column.getBlock(y);
+            if (!state.isAir() && state.getFluidState().isEmpty()) {
+                floorY = y;
+                break;
+            }
+        }
+
+        int biomeY = Math.max(minY, floorY);
+        Holder<Biome> biome = binding.generator.getBiomeSource().getNoiseBiome(
+                QuartPos.fromBlock(blockX), QuartPos.fromBlock(biomeY), QuartPos.fromBlock(blockZ),
+                binding.randomState.sampler());
+        if (floorY < minY) {
+            return new Sample(surfaceY, floorY, biome,
+                    fallbackSurfaceBlock(biome), fallbackOceanFloorBlock(biome));
+        }
+        if (binding.fastHeightSampling) {
+            SurfaceMaterial material = inferSurfaceMaterial(biome, floorY, surfaceY > floorY);
+            return new Sample(surfaceY, floorY, biome, material.surface, material.floor);
+        }
+        BlockState floorBlock = validSolid(column.getBlock(floorY))
+                ? column.getBlock(floorY) : fallbackOceanFloorBlock(biome);
+        BlockState surfaceBlock = surfaceY == floorY && validSolid(column.getBlock(surfaceY))
+                ? column.getBlock(surfaceY) : fallbackSurfaceBlock(biome);
+        return new Sample(surfaceY, floorY, biome, surfaceBlock, floorBlock);
+    }
+
+    private static boolean validSolid(BlockState state) {
+        return state != null && !state.isAir() && state.getFluidState().isEmpty();
+    }
+
+    private static String biomeId(Holder<Biome> biome) {
+        return biome.unwrapKey().map(ResourceKey::identifier).map(Object::toString)
+                .orElseGet(() -> "direct:" + System.identityHashCode(biome.value()));
+    }
+
+    private static SurfaceMaterial inferSurfaceMaterial(Holder<Biome> biome, int floorY, boolean ocean) {
+        String path = biome.unwrapKey().map(ResourceKey::identifier).map(id -> id.getPath())
+                .orElse("").toLowerCase(Locale.ROOT);
+        BlockState floor = fallbackOceanFloorBlock(biome);
+        if (path.contains("mud") || path.contains("mangrove")) floor = Blocks.MUD.defaultBlockState();
+        else if (path.contains("gravel") || path.contains("rocky")) floor = Blocks.GRAVEL.defaultBlockState();
+
+        BlockState surface;
+        if (path.contains("calcite")) surface = Blocks.CALCITE.defaultBlockState();
+        else if (path.contains("basalt") || path.contains("volcan")) surface = Blocks.BASALT.defaultBlockState();
+        else if (path.contains("stony") || path.contains("rocky") || path.contains("crag")) {
+            surface = Blocks.STONE.defaultBlockState();
+        } else if (path.contains("mud") || path.contains("mangrove")) surface = Blocks.MUD.defaultBlockState();
+        else if (path.contains("snow") || path.contains("frozen") || path.contains("ice")
+                || (biome.value().getBaseTemperature() < 0.15F && floorY > 80)) {
+            surface = Blocks.SNOW_BLOCK.defaultBlockState();
+        } else {
+            surface = fallbackSurfaceBlock(biome);
+        }
+        return new SurfaceMaterial(surface, ocean ? floor : surface);
+    }
+
+    private static BlockState fallbackSurfaceBlock(Holder<Biome> biome) {
+        String path = biome.unwrapKey().map(ResourceKey::identifier).map(id -> id.getPath()).orElse("");
+        if (biome.is(BiomeTags.IS_BADLANDS) || path.contains("badlands")) {
+            return Blocks.RED_SAND.defaultBlockState();
+        }
+        if (biome.is(BiomeTags.IS_BEACH) || path.contains("desert") || path.contains("beach")) {
+            return Blocks.SAND.defaultBlockState();
+        }
+        if (path.contains("snow") || path.contains("frozen") || path.contains("ice")) {
+            return Blocks.SNOW_BLOCK.defaultBlockState();
+        }
+        if (path.contains("mushroom")) {
+            return Blocks.MYCELIUM.defaultBlockState();
+        }
+        return Blocks.GRASS_BLOCK.defaultBlockState();
+    }
+
+    private static BlockState fallbackOceanFloorBlock(Holder<Biome> biome) {
+        String path = biome.unwrapKey().map(ResourceKey::identifier).map(id -> id.getPath()).orElse("");
+        if (path.contains("cold") || path.contains("frozen")) {
+            return Blocks.GRAVEL.defaultBlockState();
+        }
+        return Blocks.SAND.defaultBlockState();
+    }
+
+    private static Sample terrainSample(SampleGrid grid, int blockX, int blockZ, boolean smooth) {
+        int stride = grid.stride;
+        int shiftedX = blockX - stride / 2;
+        int shiftedZ = blockZ - stride / 2;
+        int leftCellX = Math.floorDiv(shiftedX, stride);
+        int leftCellZ = Math.floorDiv(shiftedZ, stride);
+        int leftX = leftCellX - grid.minimumCellX;
+        int leftZ = leftCellZ - grid.minimumCellZ;
+        int fractionX = Math.floorMod(shiftedX, stride);
+        int fractionZ = Math.floorMod(shiftedZ, stride);
+        int nearestX = leftX + (fractionX * 2 >= stride ? 1 : 0);
+        int nearestZ = leftZ + (fractionZ * 2 >= stride ? 1 : 0);
+        if (!smooth) {
+            return grid.samples[nearestZ * grid.width + nearestX];
+        }
+
+        Sample s00 = grid.samples[leftZ * grid.width + leftX];
+        Sample s10 = grid.samples[leftZ * grid.width + leftX + 1];
+        Sample s01 = grid.samples[(leftZ + 1) * grid.width + leftX];
+        Sample s11 = grid.samples[(leftZ + 1) * grid.width + leftX + 1];
+
+        int minSurface = Math.min(Math.min(s00.surfaceY, s10.surfaceY), Math.min(s01.surfaceY, s11.surfaceY));
+        int maxSurface = Math.max(Math.max(s00.surfaceY, s10.surfaceY), Math.max(s01.surfaceY, s11.surfaceY));
+        Sample nearest = grid.samples[nearestZ * grid.width + nearestX];
+
+        // Large changes are likely cliffs or sharp peaks. Ease the interpolation
+        // toward a steep S-curve instead of switching to a whole nearest-sample
+        // plate; that keeps cliffs sharp without creating stride-sized towers.
+        int heightRange = maxSurface - minSurface;
+        fractionX = slopeAwareFraction(fractionX, stride, heightRange);
+        fractionZ = slopeAwareFraction(fractionZ, stride, heightRange);
+
+        int surfaceY = bilinear(s00.surfaceY, s10.surfaceY, s01.surfaceY, s11.surfaceY,
+                fractionX, fractionZ, stride);
+        int floorY = Math.min(surfaceY, bilinear(s00.floorY, s10.floorY, s01.floorY, s11.floorY,
+                fractionX, fractionZ, stride));
+        return new Sample(surfaceY, floorY, nearest.biome, nearest.surfaceBlock, nearest.floorBlock);
+    }
+
+    private static int slopeAwareFraction(int fraction, int stride, int heightRange) {
+        int threshold = Math.max(8, stride * 2);
+        if (heightRange <= threshold || fraction == 0) {
+            return fraction;
+        }
+        double linear = fraction / (double) stride;
+        double eased = linear * linear * (3.0 - 2.0 * linear);
+        double strength = Math.min(1.0, (heightRange - threshold) / (double) (stride * 4));
+        return (int) Math.round((linear + (eased - linear) * strength) * stride);
+    }
+
+    private static int bilinear(int v00, int v10, int v01, int v11, int fractionX, int fractionZ,
+                                int stride) {
+        int inverseX = stride - fractionX;
+        int inverseZ = stride - fractionZ;
+        long value = (long) v00 * inverseX * inverseZ
+                + (long) v10 * fractionX * inverseZ
+                + (long) v01 * inverseX * fractionZ
+                + (long) v11 * fractionX * fractionZ;
+        long divisor = (long) stride * stride;
+        return (int) Math.floorDiv(value + divisor / 2, divisor);
+    }
+
+    private static void addVegetation(Binding binding, Mapper mapper,
+                                      Int2ObjectOpenHashMap<VoxelizedSection> sections,
+                                      int chunkX, int chunkZ, Sample[] columns, int maxY) {
+        // A world-space blue-noise-like distribution replaces the old four
+        // fixed chunk quadrants. Local hash minima keep trees separated without
+        // exposing rows or chunk-aligned stripes.
+        for (int localZ = 3; localZ <= 12; localZ++) {
+            for (int localX = 3; localX <= 12; localX++) {
+                int blockX = (chunkX << 4) + localX;
+                int blockZ = (chunkZ << 4) + localZ;
+                long spatialHash = treeSpatialHash(binding.seed, blockX, blockZ);
+                if (!isLocalTreeMinimum(binding.seed, blockX, blockZ, spatialHash)) {
+                    continue;
+                }
+
+                long random = mix64(spatialHash ^ 0xD1B54A32D192ED03L);
+                Sample ground = columns[(localZ << 4) | localX];
+                if (ground == null || ground.isOcean() || ground.surfaceY + 14 >= maxY) {
+                    continue;
+                }
+                BiomeProfile profile = biomeProfile(binding, ground.biome);
+                if ((random & 0xFF) >= profile.treeChance) {
+                    continue;
+                }
+
+                int height = profile.style.baseHeight + (int) ((random >>> 20) & 3);
+                placeTree(mapper, sections, chunkX, chunkZ, localX, ground.surfaceY, localZ,
+                        height, profile.style, ground.biome, random);
+            }
+        }
+    }
+
+    private static long treeSpatialHash(long seed, int blockX, int blockZ) {
+        return mix64(seed
+                ^ ((long) blockX * 0x9E3779B97F4A7C15L)
+                ^ ((long) blockZ * 0xC2B2AE3D27D4EB4FL));
+    }
+
+    private static boolean isLocalTreeMinimum(long seed, int blockX, int blockZ, long centerHash) {
+        for (int z = blockZ - 2; z <= blockZ + 2; z++) {
+            for (int x = blockX - 2; x <= blockX + 2; x++) {
+                if ((x != blockX || z != blockZ)
+                        && Long.compareUnsigned(treeSpatialHash(seed, x, z), centerHash) < 0) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private static BiomeProfile biomeProfile(Binding binding, Holder<Biome> biome) {
+        return binding.biomeProfiles.computeIfAbsent(biomeId(biome), ignored -> buildBiomeProfile(biome));
+    }
+
+    private static BiomeProfile buildBiomeProfile(Holder<Biome> biome) {
+        String path = biome.unwrapKey().map(ResourceKey::identifier).map(id -> id.getPath()).orElse("");
+        StringBuilder featureHints = new StringBuilder(path);
+        try {
+            for (var featureSet : biome.value().getGenerationSettings().features()) {
+                for (var feature : featureSet) {
+                    feature.unwrapKey().map(ResourceKey::identifier).ifPresent(id ->
+                            featureHints.append(' ').append(id.getNamespace()).append(':').append(id.getPath()));
+                }
+            }
+        } catch (RuntimeException ignored) {
+            // A malformed or unusually dynamic datapack should not disable the
+            // terrain sampler; path/tags remain a useful fallback.
+        }
+        String hints = featureHints.toString().toLowerCase(Locale.ROOT);
+        boolean advertisesTrees = hints.contains("tree") || hints.contains("forest")
+                || hints.contains("wood") || hints.contains("grove");
+
+        int chance;
+        if (biome.is(BiomeTags.IS_OCEAN) || biome.is(BiomeTags.IS_BEACH)
+                || biome.is(BiomeTags.IS_BADLANDS) || path.contains("desert")
+                || path.contains("mushroom") || path.contains("river")) {
+            chance = 0;
+        } else if (biome.is(BiomeTags.IS_JUNGLE) || hints.contains("rainforest")) {
+            chance = 230;
+        } else if (hints.contains("dark_forest")) {
+            chance = 225;
+        } else if (biome.is(BiomeTags.IS_FOREST) || hints.contains("forest")) {
+            chance = 205;
+        } else if (biome.is(BiomeTags.IS_TAIGA) || hints.contains("taiga") || hints.contains("grove")) {
+            chance = 190;
+        } else if (hints.contains("swamp") || hints.contains("mangrove")) {
+            chance = 150;
+        } else if (biome.is(BiomeTags.IS_SAVANNA) || hints.contains("savanna")) {
+            chance = 80;
+        } else if (advertisesTrees) {
+            chance = 150;
+        } else {
+            chance = 22;
+        }
+
+        return new BiomeProfile(chance, treeStyle(biome, hints));
+    }
+
+    private static TreeStyle treeStyle(Holder<Biome> biome, String hints) {
+        if (hints.contains("cherry")) {
+            return new TreeStyle(Blocks.CHERRY_LOG.defaultBlockState(), Blocks.CHERRY_LEAVES.defaultBlockState(),
+                    TreeShape.ROUND, 5);
+        }
+        if (biome.is(BiomeTags.IS_JUNGLE) || hints.contains("jungle") || hints.contains("rainforest")) {
+            return new TreeStyle(Blocks.JUNGLE_LOG.defaultBlockState(), Blocks.JUNGLE_LEAVES.defaultBlockState(),
+                    TreeShape.ROUND, 8);
+        }
+        if (biome.is(BiomeTags.IS_TAIGA) || hints.contains("spruce") || hints.contains("pine")
+                || hints.contains("taiga") || hints.contains("snow") || hints.contains("frozen")
+                || biome.value().getBaseTemperature() < 0.15F) {
+            return new TreeStyle(Blocks.SPRUCE_LOG.defaultBlockState(), Blocks.SPRUCE_LEAVES.defaultBlockState(),
+                    TreeShape.CONIFER, 7);
+        }
+        if (biome.is(BiomeTags.IS_SAVANNA) || hints.contains("acacia") || hints.contains("savanna")) {
+            return new TreeStyle(Blocks.ACACIA_LOG.defaultBlockState(), Blocks.ACACIA_LEAVES.defaultBlockState(),
+                    TreeShape.FLAT, 6);
+        }
+        if (hints.contains("dark_oak") || hints.contains("dark_forest")) {
+            return new TreeStyle(Blocks.DARK_OAK_LOG.defaultBlockState(), Blocks.DARK_OAK_LEAVES.defaultBlockState(),
+                    TreeShape.ROUND, 6);
+        }
+        if (hints.contains("birch")) {
+            return new TreeStyle(Blocks.BIRCH_LOG.defaultBlockState(), Blocks.BIRCH_LEAVES.defaultBlockState(),
+                    TreeShape.ROUND, 6);
+        }
+        if (hints.contains("mangrove")) {
+            return new TreeStyle(Blocks.MANGROVE_LOG.defaultBlockState(), Blocks.MANGROVE_LEAVES.defaultBlockState(),
+                    TreeShape.FLAT, 6);
+        }
+        return new TreeStyle(Blocks.OAK_LOG.defaultBlockState(), Blocks.OAK_LEAVES.defaultBlockState(),
+                TreeShape.ROUND, 5);
+    }
+
+    private static void placeTree(Mapper mapper, Int2ObjectOpenHashMap<VoxelizedSection> sections,
+                                  int chunkX, int chunkZ, int x, int groundY, int z, int height,
+                                  TreeStyle style, Holder<Biome> biome, long random) {
+        long logId = prediction(mapper.getBaseId((byte) 15, style.log, biome));
+        long leavesId = prediction(mapper.getBaseId((byte) 15, style.leaves, biome));
+        int topY = groundY + height;
+        int crownX = x + (int) ((random >>> 28) & 3) % 3 - 1;
+        int crownZ = z + (int) ((random >>> 32) & 3) % 3 - 1;
+
+        if (style.shape == TreeShape.CONIFER) {
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY + 1, crownZ, 0, leavesId, random + 1);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY, crownZ, 1, leavesId, random + 2);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 1, crownZ, 1, leavesId, random + 3);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 2, crownZ, 2, leavesId, random + 4);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 3, crownZ, 1, leavesId, random + 5);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 4, crownZ,
+                    height >= 9 ? 3 : 2, leavesId, random + 6);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 5, crownZ, 1, leavesId, random + 7);
+        } else if (style.shape == TreeShape.FLAT) {
+            int branchX = ((random >>> 36) & 1) == 0 ? -1 : 1;
+            int branchZ = ((random >>> 37) & 1) == 0 ? -1 : 1;
+            crownX = x + branchX;
+            crownZ = z + branchZ;
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 1, crownZ, 2, leavesId, random + 8);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY, crownZ, 3, leavesId, random + 9);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY + 1, crownZ, 1, leavesId, random + 10);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX - branchX * 2, topY, crownZ,
+                    2, leavesId, random + 11);
+            putBlock(sections, chunkX, chunkZ, x + branchX, topY - 1, z + branchZ, logId, false);
+            putBlock(sections, chunkX, chunkZ, crownX, topY, crownZ, logId, false);
+        } else {
+            int radius = height >= 9 ? 3 : 2;
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 2, crownZ,
+                    Math.max(1, radius - 1), leavesId, random + 12);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY - 1, crownZ, radius, leavesId, random + 13);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY, crownZ, radius, leavesId, random + 14);
+            putCanopyLayer(sections, chunkX, chunkZ, crownX, topY + 1, crownZ, 1, leavesId, random + 15);
+        }
+
+        for (int y = groundY + 1; y <= topY; y++) {
+            int trunkX = style.shape == TreeShape.FLAT && y > groundY + height * 2 / 3 ? crownX : x;
+            int trunkZ = style.shape == TreeShape.FLAT && y > groundY + height * 2 / 3 ? crownZ : z;
+            putBlock(sections, chunkX, chunkZ, trunkX, y, trunkZ, logId, false);
+        }
+    }
+
+    private static void putCanopyLayer(Int2ObjectOpenHashMap<VoxelizedSection> sections,
+                                       int chunkX, int chunkZ, int centerX, int y, int centerZ,
+                                       int radius, long id, long random) {
+        for (int z = centerZ - radius; z <= centerZ + radius; z++) {
+            for (int x = centerX - radius; x <= centerX + radius; x++) {
+                int dx = Math.abs(x - centerX);
+                int dz = Math.abs(z - centerZ);
+                long cellRandom = mix64(random ^ ((long) x * 0x9E3779B97F4A7C15L)
+                        ^ ((long) y * 0x94D049BB133111EBL) ^ ((long) z * 0xC2B2AE3D27D4EB4FL));
+                boolean extremeCorner = radius > 1 && dx == radius && dz == radius;
+                boolean raggedEdge = radius > 1 && Math.max(dx, dz) == radius && (cellRandom & 15) == 0;
+                if ((!extremeCorner || (cellRandom & 3) == 0) && !raggedEdge) {
+                    putBlock(sections, chunkX, chunkZ, x, y, z, id, true);
+                }
+            }
+        }
+    }
+
+    private static long mix64(long value) {
+        value = (value ^ (value >>> 30)) * 0xBF58476D1CE4E5B9L;
+        value = (value ^ (value >>> 27)) * 0x94D049BB133111EBL;
+        return value ^ (value >>> 31);
+    }
+
+    private static int lowestNeighborFloor(Sample[] samples, int width, int sampleX, int sampleZ,
+                                           int fallback) {
+        int lowest = fallback;
+        for (int z = sampleZ - 1; z <= sampleZ + 1; z++) {
+            for (int x = sampleX - 1; x <= sampleX + 1; x++) {
+                int floorY = samples[z * width + x].floorY;
+                if (floorY < lowest) {
+                    lowest = floorY;
+                }
+            }
+        }
+        return lowest;
+    }
+
+    private static long prediction(long id) {
+        return id | PREDICTION_MARKER;
+    }
+
+    private static VoxelizedSection createLitSection(int chunkX, int sectionY, int chunkZ) {
+        VoxelizedSection section = VoxelizedSection.createEmpty().setPosition(chunkX, sectionY, chunkZ);
+        // Opaque faces receive their light from neighboring voxels. Predicted
+        // terrain is outdoors, so its surrounding air must carry full skylight.
+        Arrays.fill(section.section, Mapper.airWithLight(15));
+        return section;
+    }
+
+    private static void putColumn(Int2ObjectOpenHashMap<VoxelizedSection> sections,
+                                  int chunkX, int chunkZ, int x, int z,
+                                  int minY, int maxY, long id) {
+        if (maxY < minY) {
+            return;
+        }
+        for (int y = minY; y <= maxY; y++) {
+            putBlock(sections, chunkX, chunkZ, x, y, z, id, false);
+        }
+    }
+
+    private static void putBlock(Int2ObjectOpenHashMap<VoxelizedSection> sections,
+                                 int chunkX, int chunkZ, int x, int y, int z, long id,
+                                 boolean onlyIfAir) {
+        if (x < 0 || x >= 16 || z < 0 || z >= 16) {
+            return;
+        }
+        int sectionY = y >> 4;
+        VoxelizedSection section = sections.computeIfAbsent(sectionY,
+                ignored -> createLitSection(chunkX, sectionY, chunkZ));
+        int index = ((y & 15) << 8) | (z << 4) | x;
+        boolean wasAir = Mapper.isAir(section.section[index]);
+        if (onlyIfAir && !wasAir) {
+            return;
+        }
+        if (wasAir && !Mapper.isAir(id)) {
+            section.lvl0NonAirCount++;
+        }
+        section.section[index] = id;
+    }
+
+    private static boolean hasExistingData(WorldEngine world, int chunkX, int chunkZ, Set<Integer> sectionYs) {
+        int baseX = (chunkX & 1) << 4;
+        int baseZ = (chunkZ & 1) << 4;
+        for (int candidateSectionY : sectionYs) {
+            // Include the neighboring vertical sections so a rough prediction cannot
+            // add a second surface just above or below an already-ingested real one.
+            for (int sectionY = candidateSectionY - 1; sectionY <= candidateSectionY + 1; sectionY++) {
+                WorldSection worldSection = world.acquireIfExists(0, chunkX >> 1, sectionY >> 1, chunkZ >> 1);
+                if (worldSection == null) {
+                    continue;
+                }
+                try {
+                    long[] data = worldSection._unsafeGetRawDataArray();
+                    int baseY = (sectionY & 1) << 4;
+                    for (int y = 0; y < 16; y++) {
+                        for (int z = 0; z < 16; z++) {
+                            int index = WorldSection.getIndex(baseX, baseY + y, baseZ + z);
+                            for (int x = 0; x < 16; x++) {
+                                long id = data[index + x];
+                                if (!Mapper.isAir(id) && (id & PREDICTION_MARKER) == 0) {
+                                    return true;
+                                }
+                            }
+                        }
+                    }
+                } finally {
+                    worldSection.release();
+                }
+            }
+        }
+        return false;
+    }
+
+    private static int sanitizeStride(int configured) {
+        if (configured <= 4) return 4;
+        if (configured <= 8) return 8;
+        if (configured <= 16) return 16;
+        if (configured <= 32) return 32;
+        if (configured <= 64) return 64;
+        return 128;
+    }
+
+    private static int strideForDistance(int distanceSquared, int innerRadius, int outerRadius) {
+        int maximum = sanitizeStride(VoxyConfig.CONFIG.seedLodSampleStride);
+        if (!VoxyConfig.CONFIG.seedLodAdaptiveQuality || maximum == 4) {
+            return maximum;
+        }
+        double distance = Math.sqrt(distanceSquared);
+        double range = Math.max(1.0, outerRadius - innerRadius);
+        double progress = Math.max(0.0, Math.min(1.0, (distance - innerRadius) / range));
+        if (maximum == 4 || progress < 0.18) {
+            return 4;
+        }
+        if (maximum == 8 || progress < 0.36) {
+            return 8;
+        }
+        if (maximum == 16 || progress < 0.54) {
+            return 16;
+        }
+        if (maximum == 32 || progress < 0.70) {
+            return 32;
+        }
+        if (maximum == 64 || progress < 0.84) {
+            return 64;
+        }
+        return 128;
+    }
+
+    private static Offset squareSpiral(long index) {
+        if (index == 0) {
+            return new Offset(0, 0);
+        }
+        long layer = (long) Math.ceil((Math.sqrt(index + 1.0) - 1.0) / 2.0);
+        long side = layer * 2;
+        long max = (side + 1) * (side + 1) - 1;
+        long offset = max - index;
+        if (offset < side) return new Offset((int) (layer - offset), (int) -layer);
+        offset -= side;
+        if (offset < side) return new Offset((int) -layer, (int) (-layer + offset));
+        offset -= side;
+        if (offset < side) return new Offset((int) (-layer + offset), (int) layer);
+        offset -= side;
+        return new Offset((int) layer, (int) (layer - offset));
+    }
+
+    public void shutdown() {
+        this.stopped = true;
+        this.binding = null;
+        this.executor.shutdownNow();
+        this.plannedTiles.clear();
+        this.completedTiles.clear();
+    }
+
+    private static final class Binding {
+        final ServerLevel level;
+        final WorldEngine world;
+        final ChunkGenerator generator;
+        final RandomState randomState;
+        final long seed;
+        final boolean fastHeightSampling;
+        final ConcurrentHashMap<SurfaceKey, SurfaceMaterial> surfaceMaterials = new ConcurrentHashMap<>();
+        final ConcurrentHashMap<String, BiomeProfile> biomeProfiles = new ConcurrentHashMap<>();
+
+        Binding(ServerLevel level, WorldEngine world, ChunkGenerator generator, RandomState randomState, long seed) {
+            this.level = level;
+            this.world = world;
+            this.generator = generator;
+            this.randomState = randomState;
+            this.seed = seed;
+            this.fastHeightSampling = generator instanceof NoiseBasedChunkGenerator;
+        }
+    }
+    private record SurfaceKey(String biomeId, int altitudeBand, boolean ocean) {}
+    private record SurfaceMaterial(BlockState surface, BlockState floor) {}
+    private record ChunkCoordinate(int chunkX, int chunkZ) {}
+    private record SampleGrid(Sample[] samples, int width, int height,
+                              int minimumCellX, int minimumCellZ, int stride) {}
+    private record TilePlan(int stride, long generation) {}
+    private record Sample(int surfaceY, int floorY, Holder<Biome> biome,
+                          BlockState surfaceBlock, BlockState floorBlock) {
+        boolean isOcean() {
+            return this.surfaceY > this.floorY;
+        }
+    }
+    private record BiomeProfile(int treeChance, TreeStyle style) {}
+    private record TreeStyle(BlockState log, BlockState leaves, TreeShape shape, int baseHeight) {}
+    private enum TreeShape { ROUND, CONIFER, FLAT }
+    private record Offset(int x, int z) {}
+
+    private record PrioritizedTask(int priority, double distance, long sequence, Runnable action)
+            implements Runnable, Comparable<PrioritizedTask> {
+        @Override
+        public void run() {
+            this.action.run();
+        }
+
+        @Override
+        public int compareTo(PrioritizedTask other) {
+            int result = Integer.compare(this.priority, other.priority);
+            if (result == 0) result = Double.compare(this.distance, other.distance);
+            if (result == 0) result = Long.compare(this.sequence, other.sequence);
+            return result;
+        }
+    }
+}
