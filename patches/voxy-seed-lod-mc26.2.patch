@@ -0,0 +1,23 @@
+package me.cortex.voxy.client.seedlod;
+
+/** One-shot outer-quality recommendation with deliberately wide hysteresis. */
+public final class SeedLodAutoQuality {
+    private SeedLodAutoQuality() {}
+
+    public static int recommend(int currentMaximumStride,
+                                double projectedSeconds, int targetSeconds) {
+        int current = sanitize(currentMaximumStride);
+        double ratio = projectedSeconds / Math.max(1.0, targetSeconds);
+        if (ratio > 3.0) return 128;
+        if (ratio > 1.20) return Math.min(128, current << 1);
+        if (ratio < 0.40) return 32;
+        if (ratio < 0.70) return Math.max(32, current >> 1);
+        return current;
+    }
+
+    private static int sanitize(int stride) {
+        if (stride <= 32) return 32;
+        if (stride <= 64) return 64;
+        return 128;
+    }
+}
diff --git a/src/main/java/me/cortex/voxy/client/seedlod/SeedLodBenchmark.java b/src/main/java/me/cortex/voxy/client/seedlod/SeedLodBenchmark.java
