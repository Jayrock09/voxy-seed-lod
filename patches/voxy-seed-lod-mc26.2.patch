+package me.cortex.voxy.client.seedlod;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class SeedLodFingerprintStoreTest {
+    @TempDir
+    Path directory;
+
+    @Test
+    void componentBoundariesCannotCollide() {
+        String first = SeedLodFingerprintStore.hashComponents(List.of("ab", "c"));
+        String second = SeedLodFingerprintStore.hashComponents(List.of("a", "bc"));
+        assertNotEquals(first, second);
+    }
+
+    @Test
+    void detectsNewMatchingAndChangedGenerators() throws Exception {
+        Path file = this.directory.resolve("world").resolve("seedlod-fingerprint.properties");
+        String first = SeedLodFingerprintStore.hashComponents(List.of("seed=1", "generator=vanilla"));
+        String second = SeedLodFingerprintStore.hashComponents(List.of("seed=1", "generator=tectonic"));
+
+        assertEquals(SeedLodFingerprintStore.State.NEW,
+                SeedLodFingerprintStore.checkAndUpdate(file, first, "vanilla").state());
+        assertEquals(SeedLodFingerprintStore.State.MATCH,
+                SeedLodFingerprintStore.checkAndUpdate(file, first, "vanilla").state());
+        assertEquals(SeedLodFingerprintStore.State.MISMATCH,
+                SeedLodFingerprintStore.checkAndUpdate(file, second, "tectonic").state());
+        assertTrue(java.nio.file.Files.isRegularFile(file));
+    }
+
+    @Test
+    void markerKeepsPredictionBitAndChangesWithFingerprint() {
+        String first = SeedLodFingerprintStore.hashComponents(List.of("one"));
+        String second = SeedLodFingerprintStore.hashComponents(List.of("two"));
+        long firstMarker = SeedLodFingerprintStore.predictionMarker(first);
+        long secondMarker = SeedLodFingerprintStore.predictionMarker(second);
+        assertEquals(1L, firstMarker & 1L);
+        assertEquals(1L, secondMarker & 1L);
+        assertNotEquals(firstMarker, secondMarker);
+        assertTrue(firstMarker < (1L << 27));
+        assertTrue(secondMarker < (1L << 27));
+    }
+}
diff --git a/src/test/java/me/cortex/voxy/common/world/WorldUpdaterHierarchyTest.java b/src/test/java/me/cortex/voxy/common/world/WorldUpdaterHierarchyTest.java
new file mode 100644
index 00000000..511e023b
--- /dev/null
+++ b/src/test/java/me/cortex/voxy/common/world/WorldUpdaterHierarchyTest.java
@@ -0,0 +1,195 @@
+package me.cortex.voxy.common.world;
+
+import me.cortex.voxy.common.util.MemoryBuffer;
+import me.cortex.voxy.common.world.other.Mapper;
+import org.junit.jupiter.api.Test;
+import org.lwjgl.system.MemoryUtil;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class WorldUpdaterHierarchyTest {
+    private static final long AIR = Mapper.airWithLight(15);
+    private static final long PREDICTED_STONE = (1L << 27) | 1L;
+    private static final long REAL_STONE = 2L << 27;
+
+    @Test
+    void requiredMaskMatchesEveryOctant() {
+        long[] data = filledAir();
+        for (int child = 0; child < 8; child++) {
+            int x = ((child & 1) << 4) + 3;
+            int y = (((child >> 2) & 1) << 4) + 5;
+            int z = (((child >> 1) & 1) << 4) + 7;
+            data[WorldSection.getIndex(x, y, z)] = PREDICTED_STONE;
+            assertEquals((1 << (child + 1)) - 1,
+                    WorldUpdater.requiredCoarseChildMask(data));
+        }
+    }
+
+    @Test
+    void partialChildMaskNeverCountsAsCompleteCoverage() {
+        int terrainOctants = 0b0000_1111;
+        assertTrue(hasVisibleCoverage(terrainOctants, 0, true));
+        assertFalse(WorldUpdater.hasCompleteCoverage(terrainOctants, 0));
+        // A coarse leaf is still visible while it has no children. Once any
+        // child is published, all required terrain octants must be present.
+        for (int partial = 1; partial != terrainOctants; partial = (partial << 1) | 1) {
+            assertFalse(WorldUpdater.hasCompleteCoverage(terrainOctants, partial));
+            assertFalse(hasVisibleCoverage(terrainOctants, partial, false));
+        }
+        assertTrue(WorldUpdater.hasCompleteCoverage(terrainOctants, terrainOctants));
+        assertTrue(hasVisibleCoverage(terrainOctants, terrainOctants, false));
+        assertTrue(WorldUpdater.hasCompleteCoverage(terrainOctants, 0xFF));
+    }
+
+    @Test
+    void materializesCompleteChildFromCoarseParent() {
+        WorldSection parent = section(2, 0, 0, 0);
+        WorldSection child = section(1, 1, 0, 1);
+        fill(parent.data, AIR);
+        fill(child.data, AIR);
+        parent.data[WorldSection.getIndex(16 + 6, 4, 16 + 9)] = PREDICTED_STONE;
+
+        assertTrue(WorldUpdater.materializeChildFallback(parent, child, 16, 0, 16));
+        // A parent cell expands to a 2 by 2 by 2 child-cell cube.
+        for (int y = 8; y <= 9; y++) {
+            for (int z = 18; z <= 19; z++) {
+                for (int x = 12; x <= 13; x++) {
+                    assertEquals(PREDICTED_STONE,
+                            child.data[WorldSection.getIndex(x, y, z)]);
+                }
+            }
+        }
+    }
+
+    @Test
+    void preservesExistingFinerOctantDuringFallbackExpansion() {
+        WorldSection parent = section(2, 0, 0, 0);
+        WorldSection child = section(1, 0, 0, 0);
+        fill(parent.data, PREDICTED_STONE);
+        fill(child.data, AIR);
+        child._unsafeSetNonEmptyChildren((byte) 1);
+        child.data[WorldSection.getIndex(2, 2, 2)] = REAL_STONE;
+
+        assertTrue(WorldUpdater.materializeChildFallback(parent, child, 0, 0, 0));
+        assertEquals(REAL_STONE, child.data[WorldSection.getIndex(2, 2, 2)]);
+        assertEquals(AIR, child.data[WorldSection.getIndex(4, 4, 4)],
+                "the entire covered grandchild octant must remain untouched");
+        assertEquals(PREDICTED_STONE, child.data[WorldSection.getIndex(20, 4, 4)],
+                "an uncovered sibling octant must inherit fallback data");
+    }
+
+    @Test
+    void levelZeroBackfillDoesNotReplaceRealTerrain() {
+        WorldSection parent = section(1, 0, 0, 0);
+        WorldSection child = section(0, 0, 0, 0);
+        fill(parent.data, PREDICTED_STONE);
+        fill(child.data, AIR);
+        child.data[WorldSection.getIndex(8, 8, 8)] = REAL_STONE;
+
+        WorldUpdater.materializeChildFallback(parent, child, 0, 0, 0);
+        assertEquals(REAL_STONE, child.data[WorldSection.getIndex(8, 8, 8)]);
+        assertEquals(PREDICTED_STONE, child.data[WorldSection.getIndex(24, 8, 8)]);
+    }
+
+    @Test
+    void concurrentSiblingPublicationProducesCompleteMask() throws Exception {
+        WorldSection parent = section(2, -3, 1, -5);
+        List<WorldSection> children = new ArrayList<>();
+        for (int child = 0; child < 8; child++) {
+            WorldSection section = section(1,
+                    (parent.x << 1) | (child & 1),
+                    (parent.y << 1) | ((child >> 2) & 1),
+                    (parent.z << 1) | ((child >> 1) & 1));
+            section.markCoarseContent();
+            children.add(section);
+        }
+
+        CountDownLatch start = new CountDownLatch(1);
+        List<Thread> threads = new ArrayList<>();
+        for (WorldSection child : children) {
+            Thread thread = new Thread(() -> {
+                try {
+                    start.await();
+                } catch (InterruptedException exception) {
+                    throw new RuntimeException(exception);
+                }
+                parent.updateEmptyChildState(child);
+            });
+            threads.add(thread);
+            thread.start();
+        }
+        start.countDown();
+        for (Thread thread : threads) thread.join();
+        assertEquals(0xFF, Byte.toUnsignedInt(parent.getNonEmptyChildren()));
+    }
+
+    @Test
+    void saveReloadPreservesCoarseHierarchyFlags() {
+        WorldSection source = section(3, -7, 2, 11);
+        fill(source.data, AIR);
+        source.data[WorldSection.getIndex(1, 2, 3)] = PREDICTED_STONE;
+        source._unsafeSetNonEmptyChildren((byte) 0b0011_1100);
+        source.markCoarseContent();
+        source.markCoarseChildrenComplete();
+
+        MemoryBuffer serialized = SaveLoadSystem3.serialize(source);
+        WorldSection restored = section(3, -7, 2, 11);
+        assertTrue(SaveLoadSystem3.deserialize(restored, serialized));
+        assertTrue(restored.hasCoarseContent());
+        assertTrue(restored.hasCompleteCoarseChildren());
+        assertEquals(0b0011_1100, Byte.toUnsignedInt(restored.getNonEmptyChildren()));
+        assertArrayEquals(source.data, restored.data);
+    }
+
+    @Test
+    void oldCacheLoadsAsNeedingHierarchyRepair() {
+        WorldSection source = section(4, 2, 0, -2);
+        fill(source.data, AIR);
+        source.data[WorldSection.getIndex(1, 1, 1)] = PREDICTED_STONE;
+        source.markCoarseContent();
+        source.markCoarseChildrenComplete();
+        MemoryBuffer serialized = SaveLoadSystem3.serialize(source);
+
+        long metadata = MemoryUtil.memGetLong(serialized.address + 8);
+        MemoryUtil.memPutLong(serialized.address + 8, metadata & ~(1L << 25));
+        WorldSection restored = section(4, 2, 0, -2);
+        assertTrue(SaveLoadSystem3.deserialize(restored, serialized));
+        assertTrue(restored.hasCoarseContent());
+        assertFalse(restored.hasCompleteCoarseChildren());
+    }
+
+    @Test
+    void negativeCoordinatesKeepCorrectChildIndex() {
+        WorldSection parent = section(2, -2, -1, -3);
+        for (int childIndex = 0; childIndex < 8; childIndex++) {
+            WorldSection child = section(1,
+                    (parent.x << 1) | (childIndex & 1),
+                    (parent.y << 1) | ((childIndex >> 2) & 1),
+                    (parent.z << 1) | ((childIndex >> 1) & 1));
+            assertEquals(childIndex, WorldSection.getChildIndex(child.x, child.y, child.z));
+        }
+    }
+
+    private static WorldSection section(int level, int x, int y, int z) {
+        return new WorldSection(level, x, y, z, null);
+    }
+
+    private static boolean hasVisibleCoverage(int requiredMask, int childMask,
+                                              boolean parentVisible) {
+        return parentVisible || WorldUpdater.hasCompleteCoverage(requiredMask, childMask);
+    }
+
+    private static long[] filledAir() {
+        long[] data = new long[WorldSection.SECTION_VOLUME];
+        fill(data, AIR);
+        return data;
+    }
+
+    private static void fill(long[] data, long value) {
+        java.util.Arrays.fill(data, value);
+    }
+}
