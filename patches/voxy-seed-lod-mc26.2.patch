+    public SeedLodMetrics.Snapshot debugSnapshot() {
+        Binding current = this.binding;
+        int cacheEntries = current == null ? 0 : current.sharedSamples.size();
+        long memory = (long) this.plannedWork.size() * 112L
+                + (long) this.completedWork.size() * 72L
+                + (long) cacheEntries * 176L
+                + (long) this.executor.getQueue().size() * 112L;
+        long repairBaseline = current == null ? 0L : current.hierarchyRepairBaseline;
+        long childBaseline = current == null ? 0L : current.hierarchyChildBaseline;
+        long replacementSectionBaseline = current == null ? 0L : current.realReplacementSectionBaseline;
+        long replacementVoxelBaseline = current == null ? 0L : current.realReplacementVoxelBaseline;
+        var state = new SeedLodMetrics.RuntimeState(current != null && !this.stopped && VoxyConfig.CONFIG.seedLodEnabled,
+                this.scannedTargetRadius < 0 ? 0 : this.scannedTargetRadius,
+                strideForDistance(0, Math.max(4, this.scannedQualityDropoff),
+                        Math.max(4, this.scannedMinimumStride),
+                        Math.max(32, this.effectiveMaximumStride),
+                        this.scannedAdaptiveQuality),
+                this.waveRing, this.executor.getQueue().size(), this.executor.getActiveCount(),
+                this.completedWork.size(), cacheEntries, memory,
+                Math.max(0L, WorldUpdater.getSeedLodHierarchyRepairs() - repairBaseline),
+                Math.max(0L, WorldUpdater.getSeedLodMaterializedChildren() - childBaseline),
+                Math.max(0L, WorldUpdater.getSeedLodRealReplacementSections() - replacementSectionBaseline),
+                Math.max(0L, WorldUpdater.getSeedLodRealReplacementVoxels() - replacementVoxelBaseline),
+                current == null ? "none" : current.generatorFingerprint.substring(0, 8),
+                this.effectiveMaximumStride, this.automaticQualityStatus);
+        return this.metrics.snapshot(state);
+    }
+
+    public synchronized String startBenchmark(int seconds) {
+        Binding current = this.binding;
+        if (current == null || this.stopped || !VoxyConfig.CONFIG.seedLodEnabled) {
+            return "Seed LOD must be active in a single-player Overworld";
+        }
+        if (this.benchmark != null) {
+            return "A Seed LOD benchmark is already running";
+        }
+        if (this.waveScanFinished && this.pendingTasks.get() == 0) {
+            return "No Seed LOD work is active. Increase the prediction distance or run this in a fresh area";
+        }
+        int duration = Math.max(5, Math.min(300, seconds));
+        long memory = this.debugSnapshot().runtime().estimatedMemoryBytes();
+        String generator = current.generator.getClass().getSimpleName() + " ["
+                + current.generatorFingerprint.substring(0, 8) + "]";
+        this.benchmark = new BenchmarkSession(current, current.metrics.totals(),
+                memory, (long) duration * 1_000_000_000L, generator,
+                new AtomicInteger(this.pendingTasks.get()));
+        this.lastBenchmark = null;
+        return null;
+    }
+
+    public SeedLodBenchmark.Result lastBenchmark() {
+        return this.lastBenchmark;
+    }
+
+    private void tickBenchmark(Minecraft client) {
+        BenchmarkSession session = this.benchmark;
+        if (session == null) return;
+        if (this.binding != session.binding) {
+            this.benchmark = null;
+            client.gui.chatListener().handleSystemMessage(Component.literal(
+                    "Seed LOD benchmark cancelled because the world changed"), false);
+            return;
+        }
+        SeedLodMetrics.Totals totals = session.binding.metrics.totals();
+        session.peakPending.accumulateAndGet(this.pendingTasks.get(), Math::max);
+        long elapsed = totals.capturedNanos() - session.start.capturedNanos();
+        boolean horizonComplete = elapsed >= 1_000_000_000L
+                && this.waveScanFinished && this.pendingTasks.get() == 0;
+        if (elapsed < session.durationNanos && !horizonComplete) return;
+        long memory = this.debugSnapshot().runtime().estimatedMemoryBytes();
+        SeedLodBenchmark.Result result = SeedLodBenchmark.calculate(session.generator,
+                session.start, totals, session.startMemoryBytes, memory,
+                session.peakPending.get());
+        this.lastBenchmark = result;
+        this.benchmark = null;
+        for (String line : result.lines()) {
+            client.gui.chatListener().handleSystemMessage(Component.literal(line), false);
+        }
+    }
+
+    public List<DebugCell> debugCells(int radiusTiles) {
+        int radius = Math.max(1, Math.min(48, radiusTiles));
+        int centerTileX = Math.floorDiv(this.playerChunkX, WAVE_TILE_CHUNKS);
+        int centerTileZ = Math.floorDiv(this.playerChunkZ, WAVE_TILE_CHUNKS);
+        int targetRadius = Math.max(0, this.scannedTargetRadius);
+        long targetSquared = (long) targetRadius * targetRadius;
+        List<DebugCell> result = new ArrayList<>((radius * 2 + 1) * (radius * 2 + 1));
+        for (int dz = -radius; dz <= radius; dz++) {
+            for (int dx = -radius; dx <= radius; dx++) {
+                int tileX = centerTileX + dx;
+                int tileZ = centerTileZ + dz;
+                long distanceSquared = minimumDistanceSquaredToRegion(
+                        this.playerChunkX, this.playerChunkZ, tileX, tileZ, WAVE_TILE_CHUNKS);
+                if (distanceSquared > targetSquared) continue;
+                int stride = strideForDistance((int) Math.min(Integer.MAX_VALUE, distanceSquared),
+                        Math.max(4, this.scannedQualityDropoff),
+                        Math.max(4, this.scannedMinimumStride),
+                        Math.max(32, this.effectiveMaximumStride),
+                        this.scannedAdaptiveQuality);
+                int level = this.scannedNSizedGeneration ? outputLevelForStride(stride) : 0;
+                WorkKey key = workKeyForTile(tileX, tileZ, level);
+                int state = 0;
+                Integer completedStride = this.completedWork.get(key);
+                if (completedStride != null && completedStride <= stride) state = 2;
+                else if (this.plannedWork.containsKey(key)) state = 1;
+                result.add(new DebugCell(dx + radius, dz + radius, level, state));
+            }
+        }
+        return result;
+    }
+
+    private static String generatorFingerprint(Binding binding) {
+        List<String> components = new ArrayList<>();
+        components.add("seedlod-prediction-version=" + SeedLodFingerprintStore.PREDICTION_VERSION);
+        components.add("seed=" + binding.seed);
+        components.add("generator=" + binding.generator.getClass().getName());
+        components.add("biomeSource=" + binding.generator.getBiomeSource().getClass().getName());
+        components.add("seaLevel=" + binding.generator.getSeaLevel());
+        components.add("minY=" + binding.generator.getMinY());
+        components.add("depth=" + binding.generator.getGenDepth());
+        try {
+            var ops = RegistryOps.create(JsonOps.INSTANCE, binding.level.registryAccess());
+            ChunkGenerator.CODEC.encodeStart(ops, binding.generator).result()
+                    .ifPresent(json -> components.add("codec=" + json));
+        } catch (Throwable throwable) {
+            components.add("codecError=" + throwable.getClass().getName());
+        }
+
+        int minY = binding.level.getMinY();
+        int maxY = binding.level.getMaxY();
+        for (int index = 0; index < 16; index++) {
+            long mixedX = mix64(0x6A09E667F3BCC909L + index * 0x9E3779B97F4A7C15L);
+            long mixedZ = mix64(0xBB67AE8584CAA73BL + index * 0xC2B2AE3D27D4EB4FL);
+            int x = (int) Math.floorMod(mixedX, 2_000_001L) - 1_000_000;
+            int z = (int) Math.floorMod(mixedZ, 2_000_001L) - 1_000_000;
+            try {
+                int floorY = binding.generator.getBaseHeight(x, z,
+                        Heightmap.Types.OCEAN_FLOOR_WG, binding.level, binding.randomState) - 1;
+                Holder<Biome> biome = binding.generator.getBiomeSource().getNoiseBiome(
+                        QuartPos.fromBlock(x), QuartPos.fromBlock(Math.max(minY, floorY)),
+                        QuartPos.fromBlock(z), binding.randomState.sampler());
+                StringBuilder sample = new StringBuilder().append(x).append(',').append(z)
+                        .append('=').append(floorY).append(',').append(biomeId(biome));
+                if (index < 8) {
+                    NoiseColumn column = binding.generator.getBaseColumn(
+                            x, z, binding.level, binding.randomState);
+                    int surfaceY = Math.max(minY, Math.min(maxY - 1, floorY));
+                    sample.append(',').append(column.getBlock(surfaceY));
+                }
+                components.add(sample.toString());
+            } catch (Throwable throwable) {
+                components.add(x + "," + z + "=error:" + throwable.getClass().getName());
+            }
+        }
+        return SeedLodFingerprintStore.hashComponents(components);
+    }
+
+    private static final class Binding {
+        final ServerLevel level;
+        final WorldEngine world;
+        final ChunkGenerator generator;
+        final RandomState randomState;
+        final long seed;
+        final boolean fastHeightSampling;
+        final String generatorFingerprint;
+        final long predictionMarker;
+        final SeedLodMetrics metrics;
+        final long hierarchyRepairBaseline;
+        final long hierarchyChildBaseline;
+        final long realReplacementSectionBaseline;
+        final long realReplacementVoxelBaseline;
+        final ConcurrentHashMap<SurfaceKey, SurfaceMaterial> surfaceMaterials = new ConcurrentHashMap<>();
+        final ConcurrentHashMap<String, BiomeProfile> biomeProfiles = new ConcurrentHashMap<>();
+        final ConcurrentHashMap<MappingKey, Long> predictionIds = new ConcurrentHashMap<>();
+        final ConcurrentHashMap<SampleKey, Sample> sharedSamples = new ConcurrentHashMap<>();
+
+        Binding(ServerLevel level, WorldEngine world, ChunkGenerator generator, RandomState randomState,
+                long seed, SeedLodMetrics metrics) {
+            this.level = level;
+            this.world = world;
+            this.generator = generator;
+            this.randomState = randomState;
+            this.seed = seed;
+            this.metrics = metrics;
+            this.fastHeightSampling = generator instanceof NoiseBasedChunkGenerator;
+            this.generatorFingerprint = SeedLodManager.generatorFingerprint(this);
+            this.predictionMarker = SeedLodFingerprintStore.predictionMarker(
+                    this.generatorFingerprint);
+            this.hierarchyRepairBaseline = WorldUpdater.getSeedLodHierarchyRepairs();
+            this.hierarchyChildBaseline = WorldUpdater.getSeedLodMaterializedChildren();
+            this.realReplacementSectionBaseline = WorldUpdater.getSeedLodRealReplacementSections();
+            this.realReplacementVoxelBaseline = WorldUpdater.getSeedLodRealReplacementVoxels();
+        }
+    }
+    private record SurfaceKey(String biomeId, int altitudeBand, boolean ocean) {}
+    private record MappingKey(BlockState state, String biomeId) {}
+    private record SampleKey(int stride, int cellX, int cellZ, boolean fast) {}
+    private record SurfaceMaterial(BlockState surface, BlockState floor) {}
+    private record ChunkCoordinate(int chunkX, int chunkZ) {}
+    private record SampleGrid(Sample[] samples, int width, int height,
+                              int minimumCellX, int minimumCellZ, int stride) {}
+    private record WorkKey(int outputLevel, int x, int z) {}
+    private record TilePlan(int stride, int outputLevel, int targetRadius,
+                            int qualityDropoff, long generation, long enqueuedNanos) {}
+    private record BenchmarkSession(Binding binding, SeedLodMetrics.Totals start,
+                                    long startMemoryBytes, long durationNanos,
+                                    String generator, AtomicInteger peakPending) {}
+    private record Sample(int surfaceY, int floorY, Holder<Biome> biome,
+                          BlockState surfaceBlock, BlockState floorBlock) {
+        boolean isOcean() {
+            return this.surfaceY > this.floorY;
+        }
+    }
+    private record BiomeProfile(int treeChance, TreeStyle style) {}
+    private record TreeStyle(BlockState log, BlockState leaves, TreeShape shape, int baseHeight) {}
+    private enum TreeShape { ROUND, CONIFER, FLAT }
+    private record Offset(int x, int z) {}
+    public record DebugCell(int relativeX, int relativeZ, int level, int state) {}
+
+    private record PrioritizedTask(int priority, double distance, long sequence, Runnable action)
+            implements Runnable, Comparable<PrioritizedTask> {
+        @Override
+        public void run() {
+            this.action.run();
+        }
+
+        @Override
+        public int compareTo(PrioritizedTask other) {
+            int result = Integer.compare(this.priority, other.priority);
+            if (result == 0) result = Double.compare(this.distance, other.distance);
+            if (result == 0) result = Long.compare(this.sequence, other.sequence);
+            return result;
+        }
+    }
