+    public void shutdown() {
+        this.stopped = true;
+        this.binding = null;
+        this.executor.shutdownNow();
+        this.plannedWork.clear();
+        this.completedWork.clear();
+        this.runningWork.clear();
+        this.benchmark = null;
+    }
