--- /dev/null
+++ b/src/main/java/me/cortex/voxy/client/seedlod/SeedLodBenchmark.java
@@ -0,0 +1,59 @@
+package me.cortex.voxy.client.seedlod;
+
+import java.util.List;
+import java.util.Locale;
+
+/** Calculates a repeatable report from two low-contention metrics snapshots. */
+public final class SeedLodBenchmark {
+    private SeedLodBenchmark() {}
+
+    public static Result calculate(String generator, SeedLodMetrics.Totals start,
+                                   SeedLodMetrics.Totals end,
+                                   long startMemoryBytes, long endMemoryBytes,
+                                   int benchmarkPeakPending) {
+        double seconds = Math.max(0.001,
+                (end.capturedNanos() - start.capturedNanos()) / 1_000_000_000.0);
+        long samples = delta(end.generatorSamples(), start.generatorSamples());
+        long sampleNanos = delta(end.generatorSampleNanos(), start.generatorSampleNanos());
+        long cells = delta(end.cellsWritten(), start.cellsWritten());
+        long sections = delta(end.sectionsWritten(), start.sectionsWritten());
+        long hits = delta(end.cacheHits(), start.cacheHits());
+        long misses = delta(end.cacheMisses(), start.cacheMisses());
+        long started = delta(end.jobsStarted(), start.jobsStarted());
+        long finished = delta(end.jobsFinished(), start.jobsFinished());
+        long cancelled = delta(end.jobsCancelled(), start.jobsCancelled());
+        long failed = delta(end.jobsFailed(), start.jobsFailed());
+        long queueNanos = delta(end.queueLatencyNanos(), start.queueLatencyNanos());
+        long chunkArea = delta(end.chunkAreaFinished(), start.chunkAreaFinished());
+        return new Result(generator, seconds, samples / seconds,
+                chunkArea / seconds, cells / seconds, sections / seconds,
+                hits + misses == 0 ? 0.0 : hits * 100.0 / (hits + misses),
+                samples == 0 ? 0.0 : sampleNanos / 1_000.0 / samples,
+                started == 0 ? 0.0 : queueNanos / 1_000_000.0 / started,
+                started, finished, cancelled, failed, benchmarkPeakPending,
+                endMemoryBytes, endMemoryBytes - startMemoryBytes);
+    }
+
+    private static long delta(long end, long start) {
+        return Math.max(0L, end - start);
+    }
+
+    public record Result(String generator, double seconds,
+                         double samplesPerSecond, double chunkAreaPerSecond,
+                         double cellsPerSecond, double sectionsPerSecond,
+                         double cacheHitPercent, double averageSampleMicros,
+                         double averageQueueLatencyMillis, long jobsStarted,
+                         long jobsFinished, long jobsCancelled, long jobsFailed,
+                         int peakPending, long endingMemoryBytes,
+                         long memoryDeltaBytes) {
+        public List<String> lines() {
+            return List.of(
+                    String.format(Locale.ROOT, "Seed LOD benchmark: %.1fs, %s", this.seconds, this.generator),
+                    String.format(Locale.ROOT, "samples %.0f/s, CPU %.1f us/sample, cache %.1f%%", this.samplesPerSecond, this.averageSampleMicros, this.cacheHitPercent),
+                    String.format(Locale.ROOT, "chunk-area %.1f/s, sections %.1f/s, cells %.0f/s", this.chunkAreaPerSecond, this.sectionsPerSecond, this.cellsPerSecond),
+                    String.format(Locale.ROOT, "jobs %d started / %d done / %d cancelled / %d failed", this.jobsStarted, this.jobsFinished, this.jobsCancelled, this.jobsFailed),
+                    String.format(Locale.ROOT, "queue %.1f ms average, peak pending %d", this.averageQueueLatencyMillis, this.peakPending),
+                    String.format(Locale.ROOT, "estimated memory %.1f MiB (%+.1f MiB during run)", this.endingMemoryBytes / 1048576.0, this.memoryDeltaBytes / 1048576.0));
+        }
+    }
+}
