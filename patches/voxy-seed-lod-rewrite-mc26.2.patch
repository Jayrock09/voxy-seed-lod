+package me.cortex.voxy.client.seedlod.rewrite;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class DisposableGenerationRegionTest {
+    @BeforeAll
+    static void bootstrapMinecraft() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void structureReferencesCannotRegressGeneratedTerrain() {
+        assertSame(ChunkStatus.CARVERS, DisposableGenerationRegion.advancedStatus(
+                ChunkStatus.CARVERS, ChunkStatus.STRUCTURE_REFERENCES));
+    }
+
+    @Test
