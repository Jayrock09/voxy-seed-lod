+            for (int childIndex = 0; childIndex < 8; childIndex++) {
+                if ((requiredChildren & (1 << childIndex)) == 0) continue;
+                int childX = (parent.x << 1) | (childIndex & 1);
+                int childY = (parent.y << 1) | ((childIndex >> 2) & 1);
+                int childZ = (parent.z << 1) | ((childIndex >> 1) & 1);
+                int parentBaseX = (childIndex & 1) << 4;
+                int parentBaseY = ((childIndex >> 2) & 1) << 4;
+                int parentBaseZ = ((childIndex >> 1) & 1) << 4;
+
+                WorldSection child = into.acquire(parent.lvl - 1, childX, childY, childZ);
+                boolean childDataChanged;
+                boolean childPresenceChanged = false;
+                try {
+                    synchronized (child) {
+                        childDataChanged = materializeChildFallback(parent, child,
+                                parentBaseX, parentBaseY, parentBaseZ);
+                        int nonAir = countNonAir(child.data);
+                        if (child.lvl == 0) {
+                            int oldNonAir = child.getNonEmptyBlockCount();
+                            if (oldNonAir != nonAir) {
+                                child.nonEmptyBlockCount = nonAir;
+                                childPresenceChanged = child.updateLvl0State();
+                            }
+                        } else if (nonAir != 0) {
+                            childPresenceChanged = child.markCoarseContent();
+                        }
+                    }
+
+                    if (childDataChanged || childPresenceChanged) {
+                        into.markDirty(child, childDataChanged ? UPDATE_TYPE_BLOCK_BIT : 0,
+                                childDataChanged ? 0x3F : 0);
+                    }
+                    if (childDataChanged) materializedChildren++;
+
+                int state = parent.updateEmptyChildState(child);
+                if (state != 0) {
+                        parentMaskChanged = true;
+                    }
+                } finally {
+                    child.release();
+                }
+            }
+
+            boolean coverageComplete = hasCompleteCoverage(requiredChildren,
+                    Byte.toUnsignedInt(parent.getNonEmptyChildren()));
+            boolean completionChanged = coverageComplete && parent.markCoarseChildrenComplete();
+            if (coverageComplete) {
+                SEED_LOD_HIERARCHY_REPAIRS.increment();
+                SEED_LOD_MATERIALIZED_CHILDREN.add(materializedChildren);
+            }
+            if (parentMaskChanged || completionChanged) {
+                into.markDirty(parent,
+                        parentMaskChanged ? UPDATE_TYPE_CHILD_EXISTENCE_BIT : 0, 0);
+            }
+        }
+    }
+
+    static int requiredCoarseChildMask(long[] parentData) {
+        int mask = 0;
+        for (int childIndex = 0; childIndex < 8; childIndex++) {
+            int baseX = (childIndex & 1) << 4;
+            int baseY = ((childIndex >> 2) & 1) << 4;
+            int baseZ = ((childIndex >> 1) & 1) << 4;
+            boolean found = false;
+            for (int y = 0; y < 16 && !found; y++) {
+                for (int z = 0; z < 16 && !found; z++) {
+                    int index = WorldSection.getIndex(baseX, baseY + y, baseZ + z);
+                    for (int x = 0; x < 16; x++) {
+                        if (!Mapper.isAir(parentData[index + x])) {
+                            mask |= 1 << childIndex;
+                            found = true;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+        return mask;
+    }
+
+    static boolean hasCompleteCoverage(int requiredMask, int childMask) {
+        return (childMask & requiredMask) == requiredMask;
+    }
+
+    static boolean materializeChildFallback(WorldSection parent, WorldSection child,
+                                            int parentBaseX, int parentBaseY,
+                                            int parentBaseZ) {
+        boolean changed = false;
+        int existingGrandchildren = child.lvl == 0 ? 0
+                : Byte.toUnsignedInt(child.getNonEmptyChildren());
+        for (int y = 0; y < 32; y++) {
+            for (int z = 0; z < 32; z++) {
+                for (int x = 0; x < 32; x++) {
+                    int childIndex = WorldSection.getIndex(x, y, z);
+                    long oldId = child.data[childIndex];
+
+                    if (child.lvl > 0) {
+                        int grandchild = WorldSection.getChildIndex(x >> 4, y >> 4, z >> 4);
+                        if ((existingGrandchildren & (1 << grandchild)) != 0) {
+                            continue;
+                        }
+                    }
+
+                    long inheritedId = parent.data[WorldSection.getIndex(
+                            parentBaseX + (x >> 1), parentBaseY + (y >> 1),
+                            parentBaseZ + (z >> 1))];
+                    // At level 0, preserve real or already predicted terrain and
+                    // only backfill its missing volume. Higher levels can replace
+                    // uncovered octants wholesale because covered octants were
+                    // skipped above and remain authoritative mips of their child.
+                    if (child.lvl == 0 && !Mapper.isAir(oldId)) {
+                        continue;
+                    }
+                    if (oldId != inheritedId) {
+                        child.data[childIndex] = inheritedId;
+                        changed = true;
+                    }
+                }
+            }
+        }
+        return changed;
+    }
+
+    private static int countNonAir(long[] data) {
+        int nonAir = 0;
+        for (long id : data) {
+            nonAir += Mapper.isAir(id) ? 0 : 1;
+        }
+        return nonAir;
+    }
+
+    public static long getSeedLodHierarchyRepairs() {
+        return SEED_LOD_HIERARCHY_REPAIRS.sum();
+    }
+
+    public static long getSeedLodMaterializedChildren() {
+        return SEED_LOD_MATERIALIZED_CHILDREN.sum();
+    }
+
+    public static long getSeedLodRealReplacementSections() {
+        return SEED_LOD_REAL_REPLACEMENT_SECTIONS.sum();
+    }
+
+    public static long getSeedLodRealReplacementVoxels() {
+        return SEED_LOD_REAL_REPLACEMENT_VOXELS.sum();
+    }
+
+    private static long packCell(int x, int y, int z) {
+        return ((long) (x & 0x3FFFFFF) << 38)
+                | ((long) (z & 0x3FFFFFF) << 12)
+                | (y & 0xFFFL);
+    }
+
+    private static int unpackCellX(long packed) {
+        return (int) (packed >> 38);
+    }
+
+    private static int unpackCellY(long packed) {
+        return (int) (packed << 52 >> 52);
+    }
+
+    private static int unpackCellZ(long packed) {
+        return (int) (packed << 26 >> 38);
+    }
+
+    private record WriteResult(LongOpenHashSet changedCells,
+                               LongOpenHashSet changedSections) {}
+
 
