+    public DisposableVoxyExtractor(DisposableGenerationRegion generator, Mapper mapper,
+                                   long predictionMarker) {
+        this.generator = generator;
+        this.mapper = mapper;
+        this.predictionMarker = predictionMarker;
+    }
