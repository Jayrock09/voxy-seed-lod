@@ -0,0 +1,120 @@
+package me.cortex.voxy.client.seedlod;
+
+import me.cortex.voxy.client.VoxyClientInstance;
+import me.cortex.voxy.client.config.VoxyConfig;
+import me.cortex.voxy.commonImpl.VoxyCommon;
+import net.fabricmc.fabric.api.client.rendering.v1.hud.HudElementRegistry;
+import net.fabricmc.fabric.api.client.rendering.v1.hud.VanillaHudElements;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.resources.Identifier;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+public final class SeedLodDebugHud {
+    private static final Identifier ID = Identifier.fromNamespaceAndPath("voxy", "seed_lod_debug");
+
+    private SeedLodDebugHud() {}
+
+    public static void init() {
+        HudElementRegistry.attachElementBefore(VanillaHudElements.CHAT, ID,
+                (graphics, deltaTracker) -> render(graphics));
+    }
+
+    private static void render(GuiGraphicsExtractor graphics) {
+        if (!VoxyConfig.CONFIG.seedLodDebugHud) return;
+        var common = VoxyCommon.getInstance();
+        if (!(common instanceof VoxyClientInstance instance)) return;
+
+        SeedLodMetrics.Snapshot snapshot = instance.getSeedLodManager().debugSnapshot();
+        List<String> lines = lines(snapshot);
+        Minecraft client = Minecraft.getInstance();
+        int width = 0;
+        for (String line : lines) width = Math.max(width, client.font.width(line));
+        int lineHeight = client.font.lineHeight + 1;
+        int panelX = 4;
+        int panelY = 4;
+        int panelWidth = width + 10;
+        int panelHeight = lines.size() * lineHeight + 8;
+        graphics.fill(panelX, panelY, panelX + panelWidth, panelY + panelHeight, 0xB0101010);
+        graphics.outline(panelX, panelY, panelWidth, panelHeight, 0xCC65D6FF);
+        for (int index = 0; index < lines.size(); index++) {
+            int color = index == 0 ? 0xFF65D6FF : 0xFFFFFFFF;
+            graphics.text(client.font, lines.get(index), panelX + 5,
+                    panelY + 4 + index * lineHeight, color, true);
+        }
+
+        if (VoxyConfig.CONFIG.seedLodDebugMap) {
+            renderMap(graphics, instance.getSeedLodManager(), panelX + panelWidth + 6, panelY);
+        }
+    }
+
+    public static List<String> lines(SeedLodMetrics.Snapshot snapshot) {
+        var runtime = snapshot.runtime();
+        long[] writes = snapshot.sectionWrites();
+        List<String> lines = new ArrayList<>();
+        lines.add("Disposable Seed LOD " + (runtime.active() ? "ACTIVE" : "INACTIVE"));
+        lines.add("generator fingerprint " + runtime.generatorFingerprint());
+        lines.add(String.format(Locale.ROOT, "radius %d  L%d at player  ring %d  %s",
+                runtime.radius(), runtime.playerLevel(), runtime.activeRing(),
+                runtime.horizonComplete() ? "complete" : "building"));
+        lines.add(String.format(Locale.ROOT, "jobs q/r/d %d/%d/%d  peak %d",
+                runtime.queued(), runtime.running(), snapshot.jobsFinished(), snapshot.peakPending()));
+        lines.add(String.format(Locale.ROOT, "real chunks %.1f/s  total %d",
+                snapshot.chunksPerSecond(), snapshot.totalChunks()));
+        lines.add(String.format(Locale.ROOT, "Voxy sections %.1f/s  cells %.0f/s",
+                snapshot.sectionsPerSecond(), snapshot.cellsPerSecond()));
+        lines.add(String.format(Locale.ROOT, "writes L0/L2/L3/L4 %d/%d/%d/%d",
+                writes[0], writes[2], writes[3], writes[4]));
+        lines.add(String.format(Locale.ROOT, "avg ms/4x4 structures %.1f terrain %.1f",
+                snapshot.structureMillis(), snapshot.terrainMillis()));
+        lines.add(String.format(Locale.ROOT, "avg ms/4x4 decoration %.1f lighting %.1f extract %.1f",
+                snapshot.decorationMillis(), snapshot.lightingMillis(), snapshot.extractionMillis()));
+        lines.add(String.format(Locale.ROOT, "queue latency %.1f ms  cancel/fail %d/%d",
+                snapshot.averageQueueLatencyMillis(), snapshot.jobsCancelled(), snapshot.jobsFailed()));
+        lines.add(String.format(Locale.ROOT, "teleport cancels %d  completed regions %d",
+                snapshot.teleportCancelled(), runtime.completedRegions()));
+        lines.add(String.format(Locale.ROOT, "hierarchy repairs/children %d/%d",
+                runtime.hierarchyRepairs(), runtime.hierarchyChildrenMaterialized()));
+        lines.add(String.format(Locale.ROOT, "real replacements sections/voxels %d/%d",
+                runtime.realReplacementSections(), runtime.realReplacementVoxels()));
+        lines.add(String.format(Locale.ROOT, "estimated Seed LOD memory %.1f MiB",
+                runtime.estimatedMemoryBytes() / 1048576.0));
+        return lines;
+    }
+
+    private static void renderMap(GuiGraphicsExtractor graphics, SeedLodManager manager,
+                                  int originX, int originY) {
+        List<SeedLodManager.DebugCell> cells = manager.debugCells(24);
+        int size = 49;
+        graphics.fill(originX, originY, originX + size + 8, originY + size + 25, 0xB0101010);
+        graphics.outline(originX, originY, size + 8, size + 25, 0xCC65D6FF);
+        for (SeedLodManager.DebugCell cell : cells) {
+            int x = originX + 4 + cell.relativeX();
+            int y = originY + 4 + cell.relativeZ();
+            graphics.fill(x, y, x + 1, y + 1, debugColor(cell.level(), cell.state()));
+        }
+        graphics.fill(originX + 4 + 24, originY + 4 + 24,
+                originX + 5 + 24, originY + 5 + 24, 0xFFFFFFFF);
+        Minecraft client = Minecraft.getInstance();
+        graphics.text(client.font, "L0 L2 L3 L4", originX + 4,
+                originY + size + 5, 0xFFFFFFFF, true);
+        graphics.text(client.font, "map: dark missing, bright done", originX + 4,
+                originY + size + 14, 0xFFB8B8B8, true);
+    }
+
+    private static int debugColor(int level, int state) {
+        int color = switch (level) {
+            case 0 -> 0xFF49D17D;
+            case 2 -> 0xFFFFD166;
+            case 3 -> 0xFFFF8C42;
+            case 4 -> 0xFFD66BFF;
+            default -> 0xFF6D7785;
+        };
+        if (state == 0) return 0xFF301C24;
+        if (state == 1) return 0xFFFFFFFF;
+        return color;
+    }
+}
