+                                baseCellY + y, baseCellZ + z, id));
+                    }
+                }
+            }
+        }
+    }
+
+    static void markPrediction(long[] data, long marker) {
+        for (int index = 0; index < data.length; index++) data[index] |= marker;
+    }
+
+    public record ExtractedRegion(int originChunkX, int originChunkZ, int targetChunks,
+                                  List<VoxelizedSection> fineSections,
+                                  List<WorldUpdater.CoarseCell> coarseCells,
+                                  long generationNanos, long lightingNanos,
+                                  long extractionNanos, long structureNanos,
+                                  long terrainNanos, long decorationNanos) {}
+}
