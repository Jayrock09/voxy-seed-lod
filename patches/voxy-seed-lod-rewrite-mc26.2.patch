+package me.cortex.voxy.client.seedlod;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Properties;
+
+/** Small sidecar used to detect world-generator changes without touching real Voxy data. */
+public final class SeedLodFingerprintStore {
+    static final int FORMAT_VERSION = 1;
+    static final int PREDICTION_VERSION = 103;
+
+    private SeedLodFingerprintStore() {}
+
+    public static String hashComponents(List<String> components) {
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            for (String component : components) {
+                byte[] bytes = component.getBytes(StandardCharsets.UTF_8);
+                digest.update((byte) (bytes.length >>> 24));
+                digest.update((byte) (bytes.length >>> 16));
+                digest.update((byte) (bytes.length >>> 8));
+                digest.update((byte) bytes.length);
+                digest.update(bytes);
+            }
+            return HexFormat.of().formatHex(digest.digest());
+        } catch (NoSuchAlgorithmException impossible) {
+            throw new IllegalStateException("SHA-256 is unavailable", impossible);
+        }
+    }
+
+    public static CheckResult checkAndUpdate(Path file, String fingerprint,
+                                             String generator) throws IOException {
+        String previous = null;
+        int previousFormat = -1;
+        int previousPredictionVersion = -1;
+        if (Files.isRegularFile(file)) {
+            Properties properties = new Properties();
+            try (Reader reader = Files.newBufferedReader(file, StandardCharsets.UTF_8)) {
+                properties.load(reader);
+            }
+            previous = properties.getProperty("fingerprint");
+            previousFormat = parseInt(properties.getProperty("formatVersion"));
+            previousPredictionVersion = parseInt(properties.getProperty("predictionVersion"));
+        }
+
+        State state;
+        if (previous == null) {
+            state = State.NEW;
+        } else if (previousFormat == FORMAT_VERSION
+                && previousPredictionVersion == PREDICTION_VERSION
+                && previous.equals(fingerprint)) {
+            state = State.MATCH;
+        } else {
+            state = State.MISMATCH;
+        }
+
+        Files.createDirectories(file.getParent());
+        Properties updated = new Properties();
+        updated.setProperty("formatVersion", Integer.toString(FORMAT_VERSION));
+        updated.setProperty("predictionVersion", Integer.toString(PREDICTION_VERSION));
+        updated.setProperty("fingerprint", fingerprint);
+        updated.setProperty("generator", generator);
+        Path temporary = Files.createTempFile(file.getParent(), "seedlod-fingerprint-", ".tmp");
+        try {
+            try (Writer writer = Files.newBufferedWriter(temporary, StandardCharsets.UTF_8)) {
+                updated.store(writer, "Voxy Seed LOD generator fingerprint");
+            }
+            try {
+                Files.move(temporary, file, StandardCopyOption.ATOMIC_MOVE,
+                        StandardCopyOption.REPLACE_EXISTING);
+            } catch (AtomicMoveNotSupportedException ignored) {
+                Files.move(temporary, file, StandardCopyOption.REPLACE_EXISTING);
+            }
+        } finally {
+            Files.deleteIfExists(temporary);
+        }
+        return new CheckResult(state, previous, fingerprint);
+    }
+
+    private static int parseInt(String value) {
+        if (value == null) return -1;
+        try {
+            return Integer.parseInt(value);
+        } catch (NumberFormatException ignored) {
+            return -1;
+        }
+    }
+
+    public static long predictionMarker(String fingerprint) {
+        long value = Long.parseUnsignedLong(fingerprint.substring(0, 6), 16);
+        return 1L | (value << 1);
+    }
+
+    public enum State { NEW, MATCH, MISMATCH }
+    public record CheckResult(State state, String previousFingerprint,
+                              String currentFingerprint) {}
+}
