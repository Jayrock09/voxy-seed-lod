--- /dev/null
+++ b/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableGenerationRegion.java
@@ -0,0 +1,196 @@
+package me.cortex.voxy.client.seedlod.rewrite;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.WorldGenRegion;
+import net.minecraft.util.StaticCache2D;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.StructureManager;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.ChunkGenerator;
+import net.minecraft.world.level.chunk.PalettedContainerFactory;
+import net.minecraft.world.level.chunk.ProtoChunk;
+import net.minecraft.world.level.chunk.UpgradeData;
+import net.minecraft.world.level.chunk.status.ChunkPyramid;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import net.minecraft.world.level.chunk.status.ChunkStep;
+import net.minecraft.world.level.levelgen.RandomState;
+import net.minecraft.world.level.levelgen.blending.Blender;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Runs real Minecraft world generation against temporary ProtoChunks. None of
+ * these chunks are registered with ChunkMap, ticketed, saved, or converted to
+ * LevelChunk objects.
+ */
+public final class DisposableGenerationRegion {
+    public static final int MINIMUM_TARGET_CHUNKS = 4;
+    public static final int MAXIMUM_TARGET_CHUNKS = 8;
+    private static final int FEATURE_HALO = 1;
+    private static final int STRUCTURE_HALO = ChunkStatus.MAX_STRUCTURE_DISTANCE;
+
+    private final ServerLevel level;
+    private final ChunkGenerator generator;
+    private final RandomState randomState;
+    private final PalettedContainerFactory palettes;
+
+    public DisposableGenerationRegion(ServerLevel level) {
+        this.level = level;
+        this.generator = level.getChunkSource().getGenerator();
+        this.randomState = level.getChunkSource().randomState();
+        this.palettes = PalettedContainerFactory.create(level.registryAccess());
+    }
+
+    public Result generate(int targetChunkX, int targetChunkZ, int targetChunks) {
+        if (targetChunks != MINIMUM_TARGET_CHUNKS
+                && targetChunks != MAXIMUM_TARGET_CHUNKS) {
+            throw new IllegalArgumentException("Disposable target must be 4 or 8 chunks");
+        }
+        int originX = Math.floorDiv(targetChunkX, targetChunks) * targetChunks;
+        int originZ = Math.floorDiv(targetChunkZ, targetChunks) * targetChunks;
+        int centerX = originX + targetChunks / 2 - 1;
+        int centerZ = originZ + targetChunks / 2 - 1;
+        int radius = STRUCTURE_HALO + targetChunks / 2 + 1;
+
+        StaticCache2D<DisposableChunkHolder> cache = StaticCache2D.create(
+                centerX, centerZ, radius, (chunkX, chunkZ) -> {
+                    var pos = new ChunkPos(chunkX, chunkZ);
+                    var chunk = new ProtoChunk(pos, UpgradeData.EMPTY, this.level,
+                            this.palettes, null);
+                    return new DisposableChunkHolder(pos, chunk);
+                });
+
+        long structureStarted = System.nanoTime();
+        cache.forEach(holder -> this.createStructureStarts(holder.getLatestChunk()));
+        forEachSquare(originX - FEATURE_HALO, originZ - FEATURE_HALO,
+                targetChunks + FEATURE_HALO * 2, (chunkX, chunkZ) -> {
+                    ChunkAccess chunk = cache.get(chunkX, chunkZ).getLatestChunk();
+                    this.createStructureReferences(cache, chunk);
+                });
+        long structureNanos = System.nanoTime() - structureStarted;
+
+        long terrainStarted = System.nanoTime();
+        this.generateTerrain(cache, originX, originZ, targetChunks);
+        long terrainNanos = System.nanoTime() - terrainStarted;
+
+        long decorationStarted = System.nanoTime();
+        forEachSquare(originX - FEATURE_HALO, originZ - FEATURE_HALO,
+                targetChunks + FEATURE_HALO * 2, (chunkX, chunkZ) -> {
+                    ChunkAccess chunk = cache.get(chunkX, chunkZ).getLatestChunk();
+                    this.decorate(cache, chunk);
+                });
+        long decorationNanos = System.nanoTime() - decorationStarted;
+
+        List<ChunkAccess> target = new ArrayList<>(targetChunks * targetChunks);
+        forEachSquare(originX, originZ, targetChunks,
+                (chunkX, chunkZ) -> target.add(cache.get(chunkX, chunkZ).getLatestChunk()));
+        return new Result(originX, originZ, targetChunks, List.copyOf(target), cache,
+                structureNanos, terrainNanos, decorationNanos);
+    }
+
+    private void createStructureStarts(ChunkAccess chunk) {
+        this.generator.createStructures(this.level.registryAccess(),
+                this.level.getChunkSource().getGeneratorState(),
+                this.level.structureManager(), chunk, this.level.getStructureManager(),
+                this.level.dimension());
+        setStatus(chunk, ChunkStatus.STRUCTURE_STARTS);
+    }
+
+    private void generateTerrain(StaticCache2D<DisposableChunkHolder> cache,
+                                 int targetOriginX, int targetOriginZ, int targetSize) {
+        StructureManager structures = this.level.structureManager();
+        // Minecraft generation is stage ordered across a neighborhood. Surface
+        // rules may query a neighboring biome, so completing one chunk through
+        // CARVERS before its neighbors have BIOMES is invalid.
+        // Placement modifiers can move their final biome check farther than a
+        // one or two chunk feature halo. Every holder is already required for
+        // structure discovery, so prime its cheap biome container as well.
+        cache.forEach(holder -> {
+            ChunkAccess chunk = holder.getLatestChunk();
+            this.generator.createBiomes(this.randomState, Blender.empty(), structures, chunk).join();
+            setStatus(chunk, ChunkStatus.BIOMES);
+        });
+        int terrainOriginX = targetOriginX - FEATURE_HALO;
+        int terrainOriginZ = targetOriginZ - FEATURE_HALO;
+        int terrainSize = targetSize + FEATURE_HALO * 2;
+        forEachSquare(terrainOriginX, terrainOriginZ, terrainSize, (chunkX, chunkZ) -> {
+            ChunkAccess chunk = cache.get(chunkX, chunkZ).getLatestChunk();
+            this.generator.fillFromNoise(Blender.empty(), this.randomState, structures, chunk).join();
+            setStatus(chunk, ChunkStatus.NOISE);
+        });
+        forEachSquare(terrainOriginX, terrainOriginZ, terrainSize, (chunkX, chunkZ) -> {
+            ChunkAccess chunk = cache.get(chunkX, chunkZ).getLatestChunk();
+            WorldGenRegion surfaceRegion = region(cache, ChunkStatus.SURFACE, chunk);
+            this.generator.buildSurface(surfaceRegion,
+                    structures.forWorldGenRegion(surfaceRegion), this.randomState, chunk);
+            setStatus(chunk, ChunkStatus.SURFACE);
+        });
+        forEachSquare(terrainOriginX, terrainOriginZ, terrainSize, (chunkX, chunkZ) -> {
+            ChunkAccess chunk = cache.get(chunkX, chunkZ).getLatestChunk();
+            WorldGenRegion carverRegion = region(cache, ChunkStatus.CARVERS, chunk);
+            this.generator.applyCarvers(carverRegion, this.level.getSeed(), this.randomState,
+                    carverRegion.getBiomeManager(), structures.forWorldGenRegion(carverRegion), chunk);
+            setStatus(chunk, ChunkStatus.CARVERS);
+        });
+    }
+
+    private void createStructureReferences(StaticCache2D<DisposableChunkHolder> cache,
+                                           ChunkAccess chunk) {
+        WorldGenRegion region = region(cache, ChunkStatus.STRUCTURE_REFERENCES, chunk);
+        this.generator.createReferences(region,
+                this.level.structureManager().forWorldGenRegion(region), chunk);
+        setStatus(chunk, ChunkStatus.STRUCTURE_REFERENCES);
+    }
+
+    private void decorate(StaticCache2D<DisposableChunkHolder> cache, ChunkAccess chunk) {
+        WorldGenRegion region = region(cache, ChunkStatus.FEATURES, chunk);
+        this.generator.applyBiomeDecoration(region, chunk,
+                this.level.structureManager().forWorldGenRegion(region));
+        setStatus(chunk, ChunkStatus.FEATURES);
+    }
+
+    private WorldGenRegion region(StaticCache2D<DisposableChunkHolder> cache,
+                                  ChunkStatus status, ChunkAccess center) {
+        ChunkStep step = ChunkPyramid.GENERATION_PYRAMID.getStepTo(status);
+        return new WorldGenRegion(this.level, castCache(cache), step, center);
+    }
+
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    private static StaticCache2D<net.minecraft.server.level.GenerationChunkHolder> castCache(
+            StaticCache2D<DisposableChunkHolder> cache) {
+        return (StaticCache2D) cache;
+    }
+
+    private static void setStatus(ChunkAccess chunk, ChunkStatus status) {
+        if (chunk instanceof ProtoChunk proto) {
+            ChunkStatus current = proto.getPersistedStatus();
+            ChunkStatus advanced = advancedStatus(current, status);
+            if (advanced != current) proto.setPersistedStatus(advanced);
+        }
+    }
+
+    static ChunkStatus advancedStatus(ChunkStatus current, ChunkStatus requested) {
+        return current.isOrAfter(requested) ? current : requested;
+    }
+
+    private static void forEachSquare(int originX, int originZ, int size,
+                                      ChunkConsumer consumer) {
+        for (int z = 0; z < size; z++) {
+            for (int x = 0; x < size; x++) {
+                consumer.accept(originX + x, originZ + z);
+            }
+        }
+    }
+
+    @FunctionalInterface
+    private interface ChunkConsumer {
+        void accept(int chunkX, int chunkZ);
+    }
+
+    public record Result(int originChunkX, int originChunkZ, int targetSizeChunks,
+                         List<ChunkAccess> targetChunks,
+                         StaticCache2D<DisposableChunkHolder> disposableCache,
+                         long structureNanos, long terrainNanos,
+                         long decorationNanos) {}
+}
diff --git a/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableLightVolume.java b/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableLightVolume.java
new file mode 100644
index 00000000..fe2eccf3
--- /dev/null
+++ b/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableLightVolume.java
@@ -0,0 +1,110 @@
+package me.cortex.voxy.client.seedlod.rewrite;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.SectionPos;
+import net.minecraft.util.StaticCache2D;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.LightLayer;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LightChunk;
+import net.minecraft.world.level.chunk.LightChunkGetter;
+import net.minecraft.world.level.lighting.LevelLightEngine;
+import net.minecraft.world.level.material.FluidState;
+
+/** Runs Minecraft's sky and block light engines over disposable chunks. */
+final class DisposableLightVolume implements LightChunkGetter, BlockGetter {
+    private static final int HALO_CHUNKS = 1;
+
+    private final StaticCache2D<DisposableChunkHolder> chunks;
+    private final int originChunkX;
+    private final int originChunkZ;
+    private final int targetChunks;
+    private final int minY;
+    private final int height;
+    private final LevelLightEngine lightEngine;
+
+    DisposableLightVolume(DisposableGenerationRegion.Result result, int minY, int height) {
+        this.chunks = result.disposableCache();
+        this.originChunkX = result.originChunkX();
+        this.originChunkZ = result.originChunkZ();
+        this.targetChunks = result.targetSizeChunks();
+        this.minY = minY;
+        this.height = height;
+        this.lightEngine = new LevelLightEngine(this, true, true);
+    }
+
+    void calculate() {
+        int minimumChunkX = this.originChunkX - HALO_CHUNKS;
+        int minimumChunkZ = this.originChunkZ - HALO_CHUNKS;
+        int size = this.targetChunks + HALO_CHUNKS * 2;
+        for (int z = 0; z < size; z++) {
+            for (int x = 0; x < size; x++) {
+                ChunkAccess chunk = this.chunk(minimumChunkX + x, minimumChunkZ + z);
+                chunk.initializeLightSources();
+                for (int sectionIndex = 0; sectionIndex < chunk.getSectionsCount(); sectionIndex++) {
+                    this.lightEngine.updateSectionStatus(
+                            SectionPos.of(chunk.getPos(),
+                                    chunk.getSectionYFromSectionIndex(sectionIndex)),
+                            chunk.getSection(sectionIndex).hasOnlyAir());
+                }
+            }
+        }
+        for (int z = 0; z < size; z++) {
+            for (int x = 0; x < size; x++) {
+                ChunkAccess chunk = this.chunk(minimumChunkX + x, minimumChunkZ + z);
+                this.lightEngine.setLightEnabled(chunk.getPos(), true);
+                this.lightEngine.propagateLightSources(chunk.getPos());
+            }
+        }
+        while (this.lightEngine.hasLightWork()) this.lightEngine.runLightUpdates();
+    }
+
+    byte packedLight(int blockX, int blockY, int blockZ) {
+        BlockPos pos = new BlockPos(blockX, blockY, blockZ);
+        int block = this.lightEngine.getLayerListener(LightLayer.BLOCK).getLightValue(pos);
+        int sky = this.lightEngine.getLayerListener(LightLayer.SKY).getLightValue(pos);
+        return (byte) ((Math.min(15, block) << 4) | Math.min(15, sky));
+    }
+
+    @Override
+    public LightChunk getChunkForLighting(int chunkX, int chunkZ) {
+        return this.chunk(chunkX, chunkZ);
+    }
+
+    @Override
+    public BlockGetter getLevel() {
+        return this;
+    }
+
+    @Override
+    public BlockEntity getBlockEntity(BlockPos pos) {
+        return null;
+    }
+
+    @Override
+    public BlockState getBlockState(BlockPos pos) {
+        return this.chunk(Math.floorDiv(pos.getX(), 16), Math.floorDiv(pos.getZ(), 16))
+                .getBlockState(pos);
+    }
+
+    @Override
+    public FluidState getFluidState(BlockPos pos) {
+        return this.getBlockState(pos).getFluidState();
+    }
+
+    @Override
+    public int getHeight() {
+        return this.height;
+    }
+
+    @Override
+    public int getMinY() {
+        return this.minY;
+    }
+
+    private ChunkAccess chunk(int chunkX, int chunkZ) {
+        return this.chunks.get(chunkX, chunkZ).getLatestChunk();
+    }
+}
diff --git a/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableVoxyExtractor.java b/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableVoxyExtractor.java
