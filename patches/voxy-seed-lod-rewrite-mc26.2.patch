+package me.cortex.voxy.client.seedlod;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class SeedLodFingerprintStoreTest {
+    @TempDir
+    Path directory;
+
+    @Test
+    void componentBoundariesCannotCollide() {
+        String first = SeedLodFingerprintStore.hashComponents(List.of("ab", "c"));
+        String second = SeedLodFingerprintStore.hashComponents(List.of("a", "bc"));
+        assertNotEquals(first, second);
+    }
+
+    @Test
+    void detectsNewMatchingAndChangedGenerators() throws Exception {
+        Path file = this.directory.resolve("world").resolve("seedlod-fingerprint.properties");
+        String first = SeedLodFingerprintStore.hashComponents(List.of("seed=1", "generator=vanilla"));
+        String second = SeedLodFingerprintStore.hashComponents(List.of("seed=1", "generator=tectonic"));
+
+        assertEquals(SeedLodFingerprintStore.State.NEW,
+                SeedLodFingerprintStore.checkAndUpdate(file, first, "vanilla").state());
+        assertEquals(SeedLodFingerprintStore.State.MATCH,
+                SeedLodFingerprintStore.checkAndUpdate(file, first, "vanilla").state());
+        assertEquals(SeedLodFingerprintStore.State.MISMATCH,
+                SeedLodFingerprintStore.checkAndUpdate(file, second, "tectonic").state());
+        assertTrue(java.nio.file.Files.isRegularFile(file));
+    }
+
+    @Test
+    void markerKeepsPredictionBitAndChangesWithFingerprint() {
+        String first = SeedLodFingerprintStore.hashComponents(List.of("one"));
+        String second = SeedLodFingerprintStore.hashComponents(List.of("two"));
+        long firstMarker = SeedLodFingerprintStore.predictionMarker(first);
+        long secondMarker = SeedLodFingerprintStore.predictionMarker(second);
+        assertEquals(1L, firstMarker & 1L);
+        assertEquals(1L, secondMarker & 1L);
+        assertNotEquals(firstMarker, secondMarker);
+        assertTrue(firstMarker < (1L << 27));
+        assertTrue(secondMarker < (1L << 27));
+    }
+}
