+package me.cortex.voxy.client.seedlod.rewrite;
+
+import net.minecraft.server.level.GenerationChunkHolder;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+
+import java.util.concurrent.CompletableFuture;
+
+/** A generation holder that is never attached to ChunkMap or chunk storage. */
+final class DisposableChunkHolder extends GenerationChunkHolder {
+    private final ChunkAccess chunk;
+
+    DisposableChunkHolder(ChunkPos pos, ChunkAccess chunk) {
+        super(pos);
+        this.chunk = chunk;
+    }
+
+    @Override
+    protected void addSaveDependency(CompletableFuture<?> future) {
+        // Disposable chunks have no save dependency by design.
+    }
+
+    @Override
+    public int getTicketLevel() {
+        return 0;
+    }
+
+    @Override
+    public int getQueueLevel() {
+        return 0;
+    }
+
+    @Override
+    public ChunkAccess getChunkIfPresentUnchecked(ChunkStatus status) {
+        return this.chunk;
+    }
+
+    @Override
+    public ChunkAccess getChunkIfPresent(ChunkStatus status) {
+        return this.chunk.getPersistedStatus().isOrAfter(status) ? this.chunk : null;
+    }
+
+    @Override
+    public ChunkAccess getLatestChunk() {
+        return this.chunk;
+    }
+
+    @Override
+    public ChunkStatus getPersistedStatus() {
+        return this.chunk.getPersistedStatus();
+    }
+
+    @Override
+    public ChunkStatus getLatestStatus() {
+        return this.chunk.getPersistedStatus();
+    }
+}
diff --git a/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableGenerationRegion.java b/src/main/java/me/cortex/voxy/client/seedlod/rewrite/DisposableGenerationRegion.java
